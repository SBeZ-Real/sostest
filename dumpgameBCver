local function cleanUnreferencedCache(validInstancesSet)
    for inst, _ in pairs(AppState.RegistryCache) do
        if not validInstancesSet[inst] then
            AppState.RegistryCache[inst] = nil
        end
    end
end

collectScriptTargets = function(mode)
    local targetList = {}
    local seen = {}
    local validInstancesSet = {}

    local function pushTarget(inst, origin)
        if not inst then return end
        local okClass, className = pcall(function() return inst.ClassName end)
        if not okClass then return end
        if className ~= "LocalScript" and className ~= "ModuleScript" then return end
        if seen[inst] then return end
        local hierarchy = getHierarchy(inst)
        local fullPath = buildDeterministicPath(origin, hierarchy, inst.Name)
        local canonicalId = getSafeCanonicalId(inst, origin)
        local searchBlob = string.lower(string.format("%s %s %s %s %s", inst.Name, cleanString(origin), fullPath, canonicalId, className)):gsub("%s+", "")
        local cachedEntry = AppState.RegistryCache[inst]
        local entry
        if cachedEntry and cachedEntry.FullPath == fullPath and cachedEntry.CanonicalId == canonicalId then
            entry = cachedEntry
            entry.SearchBlob = searchBlob
            entry.Metadata = entry.Metadata or __CBX.getInstanceMetadata(inst)
        else
            entry = {
                Instance = inst,
                Origin = cleanString(origin),
                Hierarchy = hierarchy,
                FullPath = fullPath,
                CanonicalId = canonicalId,
                SearchBlob = searchBlob,
                Method = "PENDING",
                ResolvedCode = nil,
                Hash = nil,
                Threat = nil,
                Metadata = __CBX.getInstanceMetadata(inst)
            }
            AppState.RegistryCache[inst] = entry
        end
        seen[inst] = true
        validInstancesSet[inst] = true
        table.insert(targetList, entry)
    end

    local function scanTree(root, origin)
        if not root then return end
        pushTarget(root, origin)
        local descendants = {}
        pcall(function() descendants = root:GetDescendants() end)
        for _, inst in ipairs(descendants) do pushTarget(inst, origin) end
    end

    if mode == "FULL" then
        local descendants = {}
        pcall(function() descendants = game:GetDescendants() end)
        for _, inst in ipairs(descendants) do pushTarget(inst, "DataModel") end
    else
        local validServices = {
            game:GetService("ReplicatedStorage"),
            game:GetService("StarterPlayer"),
            game:GetService("StarterGui"),
            game:GetService("StarterPack"),
            game:GetService("ReplicatedFirst"),
            game:GetService("Workspace")
        }
        local pScripts = localPlayer:FindFirstChild("PlayerScripts")
        local pGui = localPlayer:FindFirstChild("PlayerGui")
        local pPack = localPlayer:FindFirstChild("Backpack")
        if pScripts then table.insert(validServices, pScripts) end
        if pGui then table.insert(validServices, pGui) end
        if pPack then table.insert(validServices, pPack) end
        for _, service in ipairs(validServices) do scanTree(service, service.Name) end
    end

    local loadedModules = {}
    pcall(function() loadedModules = getModules() end)
    for _, inst in ipairs(loadedModules) do
        if typeof(inst) == "Instance" then pushTarget(inst, "LoadedModules") end
    end

    local nilInstances = {}
    pcall(function() nilInstances = getNil() end)
    for _, inst in ipairs(nilInstances) do
        if typeof(inst) == "Instance" then scanTree(inst, "NilInstances") end
    end

    cleanUnreferencedCache(validInstancesSet)
    table.sort(targetList, function(a, b)
        if a.FullPath == b.FullPath then return a.CanonicalId < b.CanonicalId end
        return a.FullPath:lower() < b.FullPath:lower()
    end)
    return targetList
end

collectRemoteTargets = function(mode)
    local remoteList = {}
    local seen = {}
    local function pushRemote(inst)
        if not inst or seen[inst] then return end
        local ok, isRemote = pcall(function()
            return inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent")
        end)
        if ok and isRemote then
            seen[inst] = true
            table.insert(remoteList, inst)
        end
    end
    local function scanTree(root)
        if not root then return end
        pushRemote(root)
        local descendants = {}
        pcall(function() descendants = root:GetDescendants() end)
        for _, inst in ipairs(descendants) do pushRemote(inst) end
    end
    if mode == "FULL" then
        local descendants = {}
        pcall(function() descendants = game:GetDescendants() end)
        for _, inst in ipairs(descendants) do pushRemote(inst) end
    else
        local validServices = {
            game:GetService("ReplicatedStorage"),
            game:GetService("StarterPlayer"),
            game:GetService("StarterGui"),
            game:GetService("StarterPack"),
            game:GetService("ReplicatedFirst"),
            game:GetService("Workspace")
        }
        local pScripts = localPlayer:FindFirstChild("PlayerScripts")
        local pGui = localPlayer:FindFirstChild("PlayerGui")
        local pPack = localPlayer:FindFirstChild("Backpack")
        if pScripts then table.insert(validServices, pScripts) end
        if pGui then table.insert(validServices, pGui) end
        if pPack then table.insert(validServices, pPack) end
        for _, service in ipairs(validServices) do scanTree(service) end
    end
    local nilInstances = {}
    pcall(function() nilInstances = getNil() end)
    for _, inst in ipairs(nilInstances) do
        if typeof(inst) == "Instance" then scanTree(inst) end
    end
    table.sort(remoteList, function(a, b) return __CBX.safeFullName(a):lower() < __CBX.safeFullName(b):lower() end)
    return remoteList
end

function __CBX.describeConnection(connection)
    local record = { Enabled = nil, ForeignState = nil, Function = nil }
    pcall(function() record.Enabled = connection.Enabled end)
    pcall(function() record.ForeignState = connection.ForeignState end)
    local fn = nil
    pcall(function() fn = connection.Function end)
    if type(fn) == "function" then
        local info = __CBX.getFunctionInfo(fn)
        record.Function = {
            Name = tostring(info.name or "anonymous"),
            Source = tostring(info.source or info.short_src or "unknown"),
            NumParams = tonumber(info.numparams) or 0,
            IsVararg = info.is_vararg == true or info.is_vararg == 1
        }
        local constants = {}
        if getConsts then pcall(function() constants = getConsts(fn) or {} end) end
        record.Function.Constants = __CBX.normalizeValue(constants)
    end
    return record
end

function __CBX.buildRemoteRecord(remote)
    local record = __CBX.getInstanceMetadata(remote)
    record.ClientConnections = {}
    if (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) and __CBX.getConnectionsFunc then
        local connections = {}
        pcall(function() connections = __CBX.getConnectionsFunc(remote.OnClientEvent) or {} end)
        for index, connection in ipairs(connections) do
            if index > 128 then break end
            table.insert(record.ClientConnections, __CBX.describeConnection(connection))
        end
    end
    if remote:IsA("RemoteFunction") then
        local fn = nil
        pcall(function() fn = remote.OnClientInvoke end)
        if type(fn) == "function" then
            record.OnClientInvoke = __CBX.describeConnection({ Function = fn })
        end
    end
    return record
end

function __CBX.getExecutorName()
