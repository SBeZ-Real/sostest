function Capability.best(list)
    local rank = {SKIPPED = 0, FAILED = 1, PRESENT = 2, VERIFIED = 3}
    local best = "SKIPPED"
    for _, name in ipairs(list) do
        local row = capProfile.Functions[name]
        if row and (rank[row.Status] or 0) > (rank[best] or 0) then
            best = row.Status
        end
    end
    return best
end

