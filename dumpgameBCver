        return
    end

    if AppState.LastSnapshot.Mode == "TARGETED" then
        modalBodyText.Text = "DIFF UNAVAILABLE:\n\nBaseline snapshot was recorded in TARGETED mode (1 script scope).\nPlease run a SMART or FULL check to establish a full-scope baseline for comparison."
        modalOverlay.Visible = true
        return
    end

    progressFill.Size = UDim2.new(0, 0, 1, 0)
    percentLabel.Text = "CALCULATING DEEP SNAPSHOT DIFF..."

    local tempCurrentScripts = {}
    local rawScriptTargets = collectScriptTargets(AppState.LastSnapshot.Mode)
    local totalScripts = #rawScriptTargets

    for idx, item in ipairs(rawScriptTargets) do
        local freshCode, freshMethod = resolveSource(item.Instance)
        local freshHash = (freshMethod == "FAILED") and "UNAVAILABLE" or computeHash(freshCode)
        local freshThreat = analyzeBackdoorThreat(item.Instance, freshCode, freshMethod)

        tempCurrentScripts[item.CanonicalId] = {
            Name = item.Instance.Name,
            FullPath = item.FullPath,
            Length = (freshMethod == "FAILED") and 0 or #freshCode,
            Hash = freshHash,
            Method = freshMethod,
            ThreatLevel = freshThreat.Level,
            ThreatScore = freshThreat.Score,
            Confidence = freshThreat.Confidence,
            ReasonsCount = #freshThreat.Reasons,
            ReasonFingerprint = buildReasonFingerprint(freshThreat)
        }

        local ratio = idx / math.max(1, totalScripts)
        progressFill.Size = UDim2.new(ratio, 0, 1, 0)
        percentLabel.Text = string.format("DIFF SCANNING %d%% (%d/%d)", math.floor(ratio * 100), idx, totalScripts)
        if idx % 12 == 0 then
            task.wait()
        end
    end

    local tempCurrentRemotes = {}
    for _, rem in ipairs(collectRemoteTargets(AppState.LastSnapshot.Mode)) do
        local fName = rem.Name
        pcall(function() fName = rem:GetFullName() end)
        tempCurrentRemotes[fName] = {
            Class = rem.ClassName
        }
    end

    local addedScripts, removedScripts, modifiedScripts, sourceStateChanges = 0, 0, 0, 0
    local methodShifts = 0
    local profileChanges = {}
    local criticalEscalations = {}
    local warningEscalations = {}
    local noticeEscalations = {}
    local deEscalations = {}

    local severityRank = {
        ["CLEAN"] = 1,
        ["LOW"] = 2,
        ["MEDIUM"] = 3,
        ["HIGH"] = 4
    }

    for id, data in pairs(tempCurrentScripts) do
        local baseData = AppState.LastSnapshot.Scripts[id]
        if not baseData then
            addedScripts = addedScripts + 1
        else
            local oldUnavailable = (baseData.Hash == "UNAVAILABLE" or baseData.ThreatLevel == "ANALYSIS_FAILED")
            local newUnavailable = (data.Hash == "UNAVAILABLE" or data.ThreatLevel == "ANALYSIS_FAILED")

            if oldUnavailable ~= newUnavailable then
                sourceStateChanges = sourceStateChanges + 1
            elseif not oldUnavailable and not newUnavailable and baseData.Hash ~= data.Hash and data.Hash ~= "00000000" then
                modifiedScripts = modifiedScripts + 1
            end

            if baseData.Method ~= data.Method then
                methodShifts = methodShifts + 1
            end

            if baseData.ReasonFingerprint ~= data.ReasonFingerprint then
                table.insert(profileChanges, string.format("  • %s | Rules: %d → %d | Score: %d → %d", data.Name, baseData.ReasonsCount or 0, data.ReasonsCount or 0, baseData.ThreatScore or 0, data.ThreatScore or 0))
            end

            if not oldUnavailable and not newUnavailable then
                local oldRank = severityRank[baseData.ThreatLevel] or 0
                local newRank = severityRank[data.ThreatLevel] or 0
                local scoreDelta = data.ThreatScore - (baseData.ThreatScore or 0)

                if newRank > oldRank then
                    if data.ThreatLevel == "HIGH" then
                        table.insert(criticalEscalations, string.format("▲ CRITICAL: %s (%s → %s | Score: %d → %d)", data.Name, baseData.ThreatLevel, data.ThreatLevel, baseData.ThreatScore or 0, data.ThreatScore or 0))
                    elseif data.ThreatLevel == "MEDIUM" then
                        table.insert(warningEscalations, string.format("▲ WARNING: %s (%s → %s | Score: %d → %d)", data.Name, baseData.ThreatLevel, data.ThreatLevel, baseData.ThreatScore or 0, data.ThreatScore or 0))
                    else
                        table.insert(noticeEscalations, string.format("▲ NOTICE: %s (%s → %s | Score: %d → %d)", data.Name, baseData.ThreatLevel, data.ThreatLevel, baseData.ThreatScore or 0, data.ThreatScore or 0))
                    end
                elseif newRank < oldRank then
                    table.insert(deEscalations, string.format("▼ DE-ESCALATED: %s (%s → %s | Score: %d → %d)", data.Name, baseData.ThreatLevel, data.ThreatLevel, baseData.ThreatScore or 0, data.ThreatScore or 0))
                elseif scoreDelta >= 30 then
                    table.insert(noticeEscalations, string.format("▲ NOTICE: %s score increased %d → %d", data.Name, baseData.ThreatScore or 0, data.ThreatScore or 0))
                end
            end
        end
    end
    for id, _ in pairs(AppState.LastSnapshot.Scripts) do
        if not tempCurrentScripts[id] then
            removedScripts = removedScripts + 1
        end
    end

    local addedRemotes, removedRemotes, modifiedRemotes = 0, 0, 0
    for path, data in pairs(tempCurrentRemotes) do
        local baseRemote = AppState.LastSnapshot.Remotes[path]
        if not baseRemote then
            addedRemotes = addedRemotes + 1
        elseif baseRemote.Class ~= data.Class then
            modifiedRemotes = modifiedRemotes + 1
        end
    end
    for path, _ in pairs(AppState.LastSnapshot.Remotes) do
        if not tempCurrentRemotes[path] then
            removedRemotes = removedRemotes + 1
        end
    end

    local diffLines = {}
    table.insert(diffLines, string.format("DEEP SNAPSHOT DIFF [%s BASELINE]", AppState.LastSnapshot.Mode))
    table.insert(diffLines, "================================================================================")
    
    table.insert(diffLines, "THREAT CHANGES:")
    if #criticalEscalations == 0 and #warningEscalations == 0 and #noticeEscalations == 0 and #deEscalations == 0 then
        table.insert(diffLines, "  No threat escalation or severity level changes detected.")
    else
        for _, item in ipairs(criticalEscalations) do
            table.insert(diffLines, "  " .. item)
        end
        for _, item in ipairs(warningEscalations) do
            table.insert(diffLines, "  " .. item)
        end
        for _, item in ipairs(noticeEscalations) do
            table.insert(diffLines, "  " .. item)
        end
        for _, item in ipairs(deEscalations) do
            table.insert(diffLines, "  " .. item)
        end
    end
    table.insert(diffLines, "--------------------------------------------------------------------------------")

    table.insert(diffLines, "SOURCE AVAILABILITY & METHOD:")
    table.insert(diffLines, string.format("  ~ %d Modified Script Bodies (Hash Mismatch)", modifiedScripts))
    table.insert(diffLines, string.format("  ? %d Source Availability Changes", sourceStateChanges))
    table.insert(diffLines, string.format("  # %d Extraction Method Alterations", methodShifts))
    table.insert(diffLines, "--------------------------------------------------------------------------------")

    table.insert(diffLines, "DETECTION RULE SHIFTS:")
    if #profileChanges == 0 then
        table.insert(diffLines, "  No detection profile changes detected.")
    else
        table.insert(diffLines, string.format("  %d detection profiles changed:", #profileChanges))
        for _, item in ipairs(profileChanges) do
            table.insert(diffLines, item)
        end
    end
    table.insert(diffLines, "--------------------------------------------------------------------------------")

    table.insert(diffLines, "STRUCTURE & INVENTORY:")
    table.insert(diffLines, string.format("  + %d New Scripts Added", addedScripts))
    table.insert(diffLines, string.format("  - %d Scripts Removed", removedScripts))
    table.insert(diffLines, string.format("  + %d New Remotes Added", addedRemotes))
    table.insert(diffLines, string.format("  - %d Remotes Removed", removedRemotes))
    table.insert(diffLines, string.format("  ~ %d Remote Class Type Mutations", modifiedRemotes))
    table.insert(diffLines, "================================================================================")
    table.insert(diffLines, string.format("Baseline Scope: %s", AppState.LastSnapshot.Scope or "UNKNOWN"))
    table.insert(diffLines, string.format("Session JobId : %s", tostring(AppState.LastSnapshot.Identity.JobId):sub(1, 14)))

    modalBodyText.Text = table.concat(diffLines, "\n")

    local bounds = TextService:GetTextSize(modalBodyText.Text, 9, Enum.Font.Gotham, Vector2.new(modalBody.AbsoluteSize.X - 20, 100000))
    modalBody.CanvasSize = UDim2.new(0, 0, 0, math.max(bounds.Y + 20, 150))
    modalBodyText.Size = UDim2.new(1, -12, 0, bounds.Y + 10)

    percentLabel.Text = "DIFF COMPARISON COMPLETE"
    modalOverlay.Visible = true
end

local function runDeepDiffScan()
    if AppState.IsRunning then return end
    setBusyState(true)

    local ok, err = xpcall(function()
        runDeepDiffScanInternal()
    end, function(e)
        return debug.traceback(e)
    end)

    setBusyState(false)
    if not ok then
        __CBX.logFailure("runDeepDiffScan", err)
        percentLabel.Text = "DIFF SCAN FAILED | _ERROR_LOG.txt"
    end
end

