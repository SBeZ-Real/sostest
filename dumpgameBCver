local function executeDumpInternal(mode)
    safeMakeDir(rootDirectory)
    local targetsToDump = {}
    if AppState.ScanMode == "TARGETED" then
        if AppState.Selected then
            targetsToDump = { AppState.Selected }
        else
            percentLabel.Text = "TARGETED DUMP: NO SCRIPT SELECTED"
            return
        end
    else
        targetsToDump = AppState.Registry
    end

    local total = #targetsToDump
    if total == 0 then
        percentLabel.Text = "NO TARGET SCRIPTS DETECTED"
        return
    end

    local masterChunks = {}
    local usedOutputPaths = {}
    local manifestData = {
        GameTitle = placeTitle,
        PlaceId = placeId,
        PlaceVersion = placeVersion,
        DumpTime = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        TotalCount = total,
        Manifest = {}
    }

    if mode == "SINGLE" or mode == "BOTH" then
        local masterHeader = string.format([=[
--------------------------------------------------------------------------------
Generated by Colors - Blue
--------------------------------------------------------------------------------
GAME_TITLE     = %s
PLACE_ID       = %d
GAME_ID        = %d
JOB_ID         = %s
PLACE_VERSION  = %d
TOTAL_SCRIPTS  = %d
DUMP_TIME      = %s
]=], quoteString(placeTitle), placeId, gameId, quoteString(jobId), placeVersion, total, quoteString(os.date("!%Y-%m-%dT%H:%M:%SZ")))
        table.insert(masterChunks, masterHeader)
    end

    for idx, entry in ipairs(targetsToDump) do
        local inst = entry.Instance
        local code = entry.ResolvedCode
        local method = entry.Method

        if not code or method == "PENDING" then
            code, method = resolveSource(inst)
            entry.ResolvedCode = code
            entry.Method = method
            if method == "FAILED" then
                entry.Hash = "UNAVAILABLE"
            else
                entry.Hash = computeHash(code)
            end
            entry.Threat = analyzeBackdoorThreat(inst, code, method)
            AppState.RegistryCache[inst] = entry
        elseif not entry.Threat then
            entry.Threat = analyzeBackdoorThreat(inst, code, method)
            AppState.RegistryCache[inst] = entry
        end

        local manifestEntry = {
            Index = idx,
            Name = inst.Name,
            Class = getClassName(inst),
            Path = entry.FullPath,
            CanonicalId = entry.CanonicalId,
            Origin = entry.Origin,
            Method = method,
            SourceLength = (method == "FAILED" or entry.Hash == "UNAVAILABLE") and 0 or #code,
            Hash = entry.Hash or (method == "FAILED" and "UNAVAILABLE" or computeHash(code)),
            ThreatScore = entry.Threat and entry.Threat.Score or 0,
            ThreatLevel = entry.Threat and entry.Threat.Level or "UNSCANNED",
            ThreatConfidence = entry.Threat and entry.Threat.Confidence or "NONE",
            AnalysisComplete = entry.Threat and entry.Threat.AnalysisComplete or false,
            BytecodeLength = __CBX.ScriptArtifacts[inst] and __CBX.ScriptArtifacts[inst].BytecodeLength or 0,
            BytecodeHash = __CBX.ScriptArtifacts[inst] and __CBX.ScriptArtifacts[inst].BytecodeHash or "UNAVAILABLE",
            Metadata = entry.Metadata or __CBX.getInstanceMetadata(inst),
            Extraction = {
                Attempts = __CBX.ScriptArtifacts[inst] and __CBX.ScriptArtifacts[inst].Attempts or {},
                ClosureAvailable = __CBX.ScriptArtifacts[inst] and __CBX.ScriptArtifacts[inst].ClosureAvailable or false
            }
        }
        table.insert(manifestData.Manifest, manifestEntry)

        if mode == "SPLIT" or mode == "BOTH" then
            local folderPath = rootDirectory .. "/" .. entry.Origin
            if #entry.Hierarchy > 0 then
                folderPath = folderPath .. "/" .. table.concat(entry.Hierarchy, "/")
            end
            safeMakeDir(folderPath)

            local baseName = cleanString(inst.Name)
            local filePath = folderPath .. "/" .. baseName .. ".luau"
            if usedOutputPaths[filePath] then
                filePath = folderPath .. "/" .. baseName .. "_" .. computeHash(entry.CanonicalId) .. ".luau"
            end
            usedOutputPaths[filePath] = true

            local fileHeader = makeFileHeader(entry, code)
            local fullOutput = fileHeader .. "\n" .. code .. "\nDATA_END\n"
            writeText(filePath, fullOutput)
            local artifacts = __CBX.ScriptArtifacts[inst]
            if artifacts and type(artifacts.Bytecode) == "string" and #artifacts.Bytecode > 0 then
                writeText(filePath:gsub("%.luau$", ".bytecode"), artifacts.Bytecode)
            end
        end

        if mode == "SINGLE" or mode == "BOTH" then
            local wrappedSource = wrapSource(code)
            local chunk = string.format([=[

--------------------------------------------------------------------------------
RECORD        = %d
NAME          = %s
CLASS         = %s
PATH          = %s
CANONICAL_ID  = %s
ORIGIN        = %s
METHOD        = %s
THREAT_LEVEL  = %s
SOURCE_LENGTH = %d
HASH          = %s
DATA_BEGIN
%s
DATA_END
]=], idx, quoteString(inst.Name), quoteString(getClassName(inst)), quoteString(entry.FullPath), quoteString(entry.CanonicalId), quoteString(entry.Origin), quoteString(method), quoteString(manifestEntry.ThreatLevel), manifestEntry.SourceLength, quoteString(manifestEntry.Hash), wrappedSource)
            table.insert(masterChunks, chunk)
        end

        local ratio = idx / total
        progressFill.Size = UDim2.new(ratio, 0, 1, 0)
        percentLabel.Text = string.format("%d%% (%d/%d) %s", math.floor(ratio * 100), idx, total, entry.FullPath:sub(1, 40))

        if idx % 12 == 0 then
            task.wait()
        end
    end

    if #masterChunks > 0 then
        writeText(masterFilePath, table.concat(masterChunks, "\n"))
    end
    local okJson, encodedManifest = pcall(HttpService.JSONEncode, HttpService, manifestData)
    if okJson then
        writeText(manifestFilePath, encodedManifest)
    end
    __CBX.exportCapabilities()
    __CBX.exportRemoteMap(AppState.ScanMode == "TARGETED" and "SMART" or AppState.ScanMode)
    local runtimeClosureCount = __CBX.exportRuntimeClosures(AppState.ScanMode == "TARGETED" and "SMART" or AppState.ScanMode)
    percentLabel.Text = string.format("DUMP COMPLETE | %d RUNTIME CLOSURES | %s", runtimeClosureCount, rootDirectory)
end

