local function isDecompileValid(source)
    if type(source) ~= "string" or #source == 0 then
        return false
    end
    local lower = source:lower()
    local invalidPatterns = {
        "failed to decode",
        "decompilation error",
        "cannot decompile",
        "decompiler error",
        "custom vm",
        "encode key",
        "unable to decompile",
        "an error occurred while decompiling",
        "failed to decompile",
        "decompile failed",
        "unsupported opcode",
        "bytecode version mismatch",
        "not a lua closure",
        "decompilation failed"
    }
    for _, pattern in ipairs(invalidPatterns) do
        if lower:find(pattern, 1, true) then
            return false
        end
    end
    return true
end

