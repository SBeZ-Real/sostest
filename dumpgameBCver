local function getSafeCanonicalId(inst, origin)
    local fullName = ""
    pcall(function() fullName = inst:GetFullName() end)
    if inst.Parent ~= nil and fullName ~= "" then return fullName end
    local debugId = nil
    pcall(function() debugId = inst:GetDebugId(32) end)
    if debugId then
        return string.format("[%s]:%s:%s:%s", origin, getClassName(inst), cleanString(inst.Name), debugId)
    end
    local hierarchy = getHierarchy(inst)
    return string.format("[%s]:%s:%s/%s", origin, getClassName(inst), table.concat(hierarchy, "/"), cleanString(inst.Name))
end

local function buildDeterministicPath(origin, hierarchy, scriptName)
    local parts = { rootDirectory, cleanString(origin) }
    local normalizedOrigin = cleanString(origin):lower()
    for index, item in ipairs(hierarchy) do
        local cleaned = cleanString(item)
        if not (index == 1 and cleaned:lower() == normalizedOrigin) then
            table.insert(parts, cleaned)
        end
    end
    table.insert(parts, cleanString(scriptName))
    return table.concat(parts, "/")
end

