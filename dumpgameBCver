local function filterDataset()
    AppState.FilteredRegistry = {}
    local query = AppState.SearchQuery:lower():gsub("%s+", "")
    for _, entry in ipairs(AppState.Registry) do
        local threatLevel = entry.Threat and entry.Threat.Level or "UNSCANNED"
        local matchFilter = (AppState.SeverityFilter == "ALL") or (AppState.SeverityFilter == threatLevel)
        local matchSearch = true
        if query ~= "" then
            matchSearch = entry.SearchBlob:find(query, 1, true) ~= nil
        end
        if matchFilter and matchSearch then
            table.insert(AppState.FilteredRegistry, entry)
        end
    end
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #AppState.FilteredRegistry * ROW_HEIGHT)
    updateVisibleRows()
end

updateVisibleRows = function()
    local totalItems = #AppState.FilteredRegistry
    local scrollY = listFrame.CanvasPosition.Y
    local rawIndex = math.floor(scrollY / ROW_HEIGHT) + 1
    local startIndex = math.max(1, rawIndex - BUFFER)
    
    for i = 1, POOL_SIZE do
        local itemIndex = startIndex + (i - 1)
        local row = rowPool[i]
        if itemIndex <= totalItems then
            local entry = AppState.FilteredRegistry[itemIndex]
            row.Entry = entry
            row.Button.Position = UDim2.new(0, 4, 0, (itemIndex - 1) * ROW_HEIGHT)
            row.Button.BackgroundColor3 = (AppState.Selected == entry) and COLORS.PanelSelected or COLORS.Panel
            row.NameLabel.Text = string.format("%d. %s", itemIndex, cleanString(entry.Instance.Name))
            row.NameLabel.TextColor3 = (AppState.Selected == entry) and COLORS.BlueLight or COLORS.Text
            row.OriginTag.Text = entry.Origin:sub(1, 10)
            
            local threatLevel = entry.Threat and entry.Threat.Level or "UNSCANNED"
            if threatLevel == "HIGH" then
                row.ThreatTag.Text = "● HIGH"
                row.ThreatTag.TextColor3 = COLORS.ThreatHigh
            elseif threatLevel == "MEDIUM" then
                row.ThreatTag.Text = "● MED"
                row.ThreatTag.TextColor3 = COLORS.ThreatMedium
            elseif threatLevel == "LOW" then
                row.ThreatTag.Text = "● LOW"
                row.ThreatTag.TextColor3 = COLORS.ThreatLow
            elseif threatLevel == "CLEAN" then
                row.ThreatTag.Text = "● CLEAN"
                row.ThreatTag.TextColor3 = COLORS.Success
            elseif threatLevel == "ANALYSIS_FAILED" then
                row.ThreatTag.Text = "● FAIL"
                row.ThreatTag.TextColor3 = COLORS.ThreatFailed
            else
                row.ThreatTag.Text = "● ?"
                row.ThreatTag.TextColor3 = COLORS.ThreatUnscanned
            end
            row.Button.Visible = true
        else
            row.Entry = nil
            row.Button.Visible = false
        end
    end
end

for i = 1, POOL_SIZE do
    local row = rowPool[i]
    row.Button.MouseButton1Click:Connect(function()
        if row.Entry then
            updatePreview(row.Entry)
            updateVisibleRows()
        end
    end)
end

