local function jumpToLine(lineNumber)
    switchTab("CODE")
    task.wait(0.05)
    local totalLines = 1
    for _ in (codeText.Text):gmatch("\n") do
        totalLines = totalLines + 1
    end
    local targetRatio = math.clamp((lineNumber - 2) / math.max(1, totalLines), 0, 1)
    local maxOffset = math.max(0, codePanel.CanvasSize.Y.Offset - codePanel.AbsoluteSize.Y)
    codePanel.CanvasPosition = Vector2.new(0, targetRatio * maxOffset)
end

updatePreview = function(entry)
    AppState.Selected = entry
    if not entry then
        detailsText.Text = "SELECT A NODE TO INSPECT DETAILS"
        codeText.Text = "No script selected."
        threatBadge.Text = "THREAT: UNSCANNED"
        threatBadge.TextColor3 = COLORS.ThreatUnscanned
        for _, c in ipairs(detectionsPanel:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
        end
        return
    end

    local inst = entry.Instance
    local code = entry.ResolvedCode or ""
    local threat = entry.Threat

    if not threat then
        threatBadge.Text = "THREAT: UNSCANNED"
        threatBadge.TextColor3 = COLORS.ThreatUnscanned
    else
        threatBadge.Text = string.format("THREAT: %s (%d)", threat.Level, threat.Score)
        if threat.Level == "HIGH" then
            threatBadge.TextColor3 = COLORS.ThreatHigh
        elseif threat.Level == "MEDIUM" then
            threatBadge.TextColor3 = COLORS.ThreatMedium
        elseif threat.Level == "LOW" then
            threatBadge.TextColor3 = COLORS.ThreatLow
        elseif threat.Level == "ANALYSIS_FAILED" then
            threatBadge.TextColor3 = COLORS.ThreatFailed
        else
            threatBadge.TextColor3 = COLORS.Success
        end
    end

    if AppState.InspectorTab == "DETAILS" then
        local indicatorStr = "UNSCANNED (RUN CHECKER TO ANALYZE)"
        if threat then
            if threat.Level == "ANALYSIS_FAILED" then
                indicatorStr = "SOURCE RESOLUTION FAILED (INACCESSIBLE / STRIPPED)"
            else
                indicatorStr = (#threat.Reasons > 0) and string.format("%d Rules Triggered", #threat.Reasons) or "NO SUSPICIOUS INDICATORS DETECTED"
            end
        end
        detailsText.Text = string.format(
            "NAME: %s\nCLASS: %s\nORIGIN: %s\nCANONICAL ID: %s\nPATH: %s\nMETHOD: %s\nSOURCE SIZE: %s\nHASH: %s\n\nCONFIDENCE: %s\nANALYSIS COMPLETE: %s\nINDICATORS: %s",
            cleanString(inst.Name),
            getClassName(inst),
            entry.Origin,
            entry.CanonicalId,
            entry.FullPath,
            entry.Method or "PENDING",
            (entry.Method == "FAILED" or entry.Hash == "UNAVAILABLE") and "UNAVAILABLE" or string.format("%d BYTES", #code),
            entry.Hash or (entry.Method == "FAILED" and "UNAVAILABLE" or computeHash(code)),
            threat and threat.Confidence or "NONE",
            threat and tostring(threat.AnalysisComplete) or "false",
            indicatorStr
        )
    elseif AppState.InspectorTab == "CODE" then
        if entry.Method == "FAILED" then
            codeText.Text = "Source code extraction failed (bytecode stripped or protected)."
            codePanel.CanvasSize = UDim2.new(0, 0, 0, 100)
        elseif code == "" and (not entry.Method or entry.Method == "PENDING") then
            codeText.Text = "Script source not yet resolved. Click RESCAN or run DUMP / CHECKER."
            codePanel.CanvasSize = UDim2.new(0, 0, 0, 100)
        else
            local formattedLines = {}
            local lineCounter = 1
            for line in code:gmatch("([^\r\n]*)[\r\n]?") do
                if lineCounter <= 2500 then
                    table.insert(formattedLines, string.format("%03d | %s", lineCounter, line))
                elseif lineCounter == 2501 then
                    table.insert(formattedLines, "... [PREVIEW TRUNCATED FOR UI PERFORMANCE - FULL SCRIPT PRESERVED FOR EXPORT/DUMP] ...")
                    break
                end
                lineCounter = lineCounter + 1
            end
            local renderedStr = table.concat(formattedLines, "\n")
            codeText.Text = renderedStr
            local bounds = TextService:GetTextSize(renderedStr, 9, Enum.Font.Code, Vector2.new(codePanel.AbsoluteSize.X - 20, 100000))
            codePanel.CanvasSize = UDim2.new(0, 0, 0, math.max(bounds.Y + 20, 200))
        end
    elseif AppState.InspectorTab == "DETECTIONS" then
        for _, c in ipairs(detectionsPanel:GetChildren()) do
