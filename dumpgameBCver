    Scan = function()
        if state.Running or state.Scanning then
            return false, "busy"
        end
        task.spawn(scanStructure)
        return true
    end,
    Run = function()
        if state.Running or state.Scanning or not state.ScanReady then
            return false, "scan structure first"
        end
        task.spawn(runDump)
        return true
    end,
    Cancel = function()
        state.Cancelled = true
        return true
    end,
    SetMode = function(mode)
        if state.Running or state.Scanning then
            return false, "busy"
        end
        local normalized = string.lower(safeString(mode))
        if normalized == "strict" then
            state.Mode = "Strict"
        elseif normalized == "deep" then
            state.Mode = "Deep"
        else
            state.Mode = "Balanced"
        end
        genv.AnyDumper_Mode = state.Mode
        updateAdvancedDefaults()
        updateUI()
        return true, state.Mode
    end,
    GetStatus = function()
        return {
            Running = state.Running,
            Scanning = state.Scanning,
            Phase = state.Phase,
            Mode = state.Mode,
            BaseRoot = state.BaseRoot,
            RunRoot = state.RunRoot,
            Code = state.Code,
            Remotes = state.Remotes,
            Runtime = state.Runtime,
            Failed = state.Failed,
            ScanReady = state.ScanReady,
            LastError = state.LastError
        }
    end,
    GetScan = function()
        return jsonSafe(scanCache)
    end,
    GetFilterReport = function()
        return buildFilterReport()
    end,
    GetCapabilities = function()
        return buildCapabilities()
    end,
    Destroy = function()
        state.Cancelled = true
        pcall(function()
            if ui.gui then
                ui.gui:Destroy()
            end
        end)
        genv.AnyDumper = nil
    end
}
