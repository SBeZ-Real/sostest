    if type(scanCache.Rejected) == "table" then
        for reason, count in pairs(scanCache.Rejected) do
            rejected[reason] = count
        end
    end
    timings = {Capabilities = timings.Capabilities or 0, Scan = timings.Scan or 0, Code = 0, Remotes = 0, Runtime = 0, Actors = 0, Network = 0, Write = 0}
