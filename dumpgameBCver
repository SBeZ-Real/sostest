function __CBX.multiply32(a, b)
    local aLow = bit32.band(a, 0xFFFF)
    local aHigh = bit32.rshift(a, 16)
    local bLow = bit32.band(b, 0xFFFF)
    local bHigh = bit32.rshift(b, 16)
    local low = aLow * bLow
    local middle = aHigh * bLow + aLow * bHigh
    return bit32.band(low + bit32.lshift(bit32.band(middle, 0xFFFF), 16), 0xFFFFFFFF)
end

local function computeHash(str)
    if type(str) ~= "string" or #str == 0 then
        return "00000000"
    end
    local h = 2166136261
    for i = 1, #str do
        h = __CBX.multiply32(bit32.bxor(h, string.byte(str, i)), 16777619)
    end
    return string.format("%08x", h)
end

local function cleanString(value)
    local result = tostring(value or ""):gsub('[\/:*?"<>|%c]', "_")
    result = result:gsub("%s+$", "")
    if #result > 80 then
        result = result:sub(1, 80)
    end
    if result == "" then
        return "Unnamed"
    end
    return result
end

