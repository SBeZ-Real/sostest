local function sanitize(value)
	value = tostring(value or "")
	value = value:gsub('[<>:"/\\|%?%*]', "_")
	value = value:gsub("[%c]", "_")
	value = value:gsub("^%s+", "")
	value = value:gsub("%s+$", "")
	value = value:gsub("%.+$", "")

	if value == "" then
		value = "_"
	end

	return value
end

local function hashString(value)
	local hash = 2166136261

	for index = 1, #value do
		hash = (hash * 16777619 + string.byte(value, index)) % 4294967296
	end

	return string.format("%08x", hash)
end

local function splitPath(instance)
	local segments = {}
	local current = instance

	while current and current ~= game do
		table.insert(segments, 1, current.Name)
		current = current.Parent
	end

	return segments
end

local function ensureFolder(parent, originalName, identity)
	local cleanName = sanitize(originalName)
	local existing = parent:FindFirstChild(cleanName)

	if existing and existing:IsA("Folder") then
		local original = existing:GetAttribute("OriginalName")

		if original == originalName then
			return existing
		end
	end

	if existing then
		cleanName = cleanName .. "__" .. hashString(identity):sub(1, 6)
	end

	local folder = Instance.new("Folder")
	folder.Name = cleanName
	folder:SetAttribute("OriginalName", originalName)
	folder.Parent = parent

	return folder
end

local function createFile(root, instance, content)
	local segments = splitPath(instance)
	local parent = root

	for index = 1, #segments - 1 do
		parent = ensureFolder(parent, segments[index], table.concat(segments, "/", 1, index))
	end

	local originalName = segments[#segments]
	local fileName = sanitize(originalName) .. ".lua"

	if parent:FindFirstChild(fileName) then
		fileName = sanitize(originalName) .. "__" .. hashString(instance:GetFullName()):sub(1, 6) .. ".lua"
	end

	local file = Instance.new("StringValue")
	file.Name = fileName
	file.Value = content
	file:SetAttribute("OriginalName", originalName)
	file:SetAttribute("OriginalFullName", instance:GetFullName())
	file:SetAttribute("ClassName", instance.ClassName)
	file.Parent = parent

	return file
end

local allowedRoots = {
	ReplicatedStorage,
	ReplicatedFirst,
	StarterPlayer,
	StarterGui,
	StarterPack,
	Workspace
}

local function isAllowed(instance)
	for _, root in ipairs(allowedRoots) do
		if instance == root or instance:IsDescendantOf(root) then
			return true
		end
	end

	return false
end

local function isClientScript(instance)
	if instance:IsA("LocalScript") then
		return true
	end

	if instance:IsA("Script") then
		local success, runContext = pcall(function()
			return instance.RunContext
		end)

		if success and tostring(runContext) == "Enum.RunContext.Client" then
			return true
		end
	end

	return false
end

local function readSource(instance)
	local success, source = pcall(function()
		return ScriptEditorService:GetEditorSource(instance)
	end)

	if success and type(source) == "string" then
		return source, "ScriptEditorService", nil
	end

	local fallbackSuccess, fallbackSource = pcall(function()
		return instance.Source
	end)

	if fallbackSuccess and type(fallbackSource) == "string" then
		return fallbackSource, "Source", nil
	end

	return nil, nil, tostring(source)
end

local remoteInstances = {}

local remoteRoots = {
	ReplicatedStorage,
	ReplicatedFirst,
	Workspace
}

for _, root in ipairs(remoteRoots) do
	for _, instance in ipairs(root:GetDescendants()) do
		if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") or instance:IsA("UnreliableRemoteEvent") then
			table.insert(remoteInstances, instance)
		end
	end
end

local function getAliases(source)
	local aliases = {}

	for variable, service in source:gmatch('local%s+([%a_][%w_]*)%s*=%s*game:GetService%s*%(%s*"([^"]+)"%s*%)') do
		aliases[variable] = service
	end

	for variable, service in source:gmatch("local%s+([%a_][%w_]*)%s*=%s*game:GetService%s*%(%s*'([^']+)'%s*%)") do
		aliases[variable] = service
	end

	return aliases
end

local function normalizeExpression(expression)
	expression = expression:gsub("%s+", "")
	expression = expression:gsub(':WaitForChild%("([^"]+)"%)', ".%1")
	expression = expression:gsub(":WaitForChild%('([^']+)'%)", ".%1")
	expression = expression:gsub(':FindFirstChild%("([^"]+)"%)', ".%1")
	expression = expression:gsub(":FindFirstChild%('([^']+)'%)", ".%1")
	expression = expression:gsub('%["([^"]+)"%]', ".%1")
	expression = expression:gsub("%['([^']+)'%]", ".%1")

	return expression
end

local function walkExpression(startInstance, path)
	local current = startInstance

	for segment in path:gmatch("%.([^%.]+)") do
		if segment == "Parent" then
			current = current and current.Parent or nil
		else
			current = current and current:FindFirstChild(segment) or nil
		end

		if not current then
			return nil
		end
	end

	return current
end

local function resolveRequire(context, expression, aliases)
	expression = normalizeExpression(expression)

	if expression:sub(1, 6) == "script" then
		local result = walkExpression(context, expression:sub(7))

		if result and result:IsA("ModuleScript") and isAllowed(result) then
			return result
		end

		return nil
	end

	local doubleService = expression:match('^game:GetService%("([^"]+)"%)')

	if doubleService then
		local serviceSuccess, service = pcall(function()
			return game:GetService(doubleService)
		end)

		if serviceSuccess then
			local prefix = 'game:GetService("' .. doubleService .. '")'
			local result = walkExpression(service, expression:sub(#prefix + 1))

			if result and result:IsA("ModuleScript") and isAllowed(result) then
				return result
			end
		end
	end

	local singleService = expression:match("^game:GetService%('([^']+)'%)")

	if singleService then
		local serviceSuccess, service = pcall(function()
			return game:GetService(singleService)
		end)

		if serviceSuccess then
			local prefix = "game:GetService('" .. singleService .. "')"
			local result = walkExpression(service, expression:sub(#prefix + 1))

			if result and result:IsA("ModuleScript") and isAllowed(result) then
				return result
			end
		end
	end

	local directService, directPath = expression:match("^game%.([%w_]+)(.*)$")

	if directService then
		local service = game:FindFirstChild(directService)

		if service then
			local result = walkExpression(service, directPath)

			if result and result:IsA("ModuleScript") and isAllowed(result) then
				return result
			end
		end
	end

	local alias, aliasPath = expression:match("^([%a_][%w_]*)(.*)$")

	if alias and aliases[alias] then
		local serviceSuccess, service = pcall(function()
			return game:GetService(aliases[alias])
		end)

		if serviceSuccess then
			local result = walkExpression(service, aliasPath)

			if result and result:IsA("ModuleScript") and isAllowed(result) then
				return result
			end
		end
	end

	return nil
end

local function extractFunctions(source)
	local found = {}
	local seen = {}

	local function add(name)
		if name and name ~= "" and not seen[name] then
			seen[name] = true
			table.insert(found, name)
		end
	end

	for name in source:gmatch("local%s+function%s+([%a_][%w_]*)%s*%(") do
		add(name)
	end

	for name in source:gmatch("function%s+([%a_][%w_%.:]*)%s*%(") do
		add(name)
	end

	for name in source:gmatch("([%a_][%w_]*)%s*=%s*function%s*%(") do
		add(name)
	end

	table.sort(found)

	return found
end

local function extractEvents(source)
	local tokens = {
		"OnClientEvent",
		"RenderStepped",
		"Heartbeat",
		"Stepped",
		"PreSimulation",
		"PostSimulation",
		"InputBegan",
		"InputEnded",
		"InputChanged",
		"Activated",
		"Deactivated",
		"Touched",
		"Changed",
		"GetPropertyChangedSignal",
		"GetAttributeChangedSignal",
		"CharacterAdded",
		"ChildAdded",
		"DescendantAdded"
	}

	local result = {}

	for _, token in ipairs(tokens) do
		if source:find(token, 1, true) then
			table.insert(result, token)
		end
	end

	return result
end

local function extractStateAccess(source)
	local tokens = {
		"GetAttribute",
		"SetAttribute",
		"WaitForChild",
		"FindFirstChild",
		"leaderstats",
		"CollectionService",
		"GetTagged",
		"Value",
		"GetPropertyChangedSignal"
	}

	local result = {}

	for _, token in ipairs(tokens) do
		if source:find(token, 1, true) then
			table.insert(result, token)
		end
	end

	return result
end

local function extractRemoteReferences(source)
	local result = {}
	local seen = {}

	for _, remote in ipairs(remoteInstances) do
		if not seen[remote] and source:find(remote.Name, 1, true) then
			seen[remote] = true

			table.insert(result, {
				name = remote.Name,
				class_name = remote.ClassName,
				full_name = remote:GetFullName()
			})
		end
	end

	table.sort(result, function(a, b)
		return a.full_name < b.full_name
	end)

	return result
end

local function extractDependencies(instance, source)
	local aliases = getAliases(source)
	local dependencies = {}
	local resolvedInstances = {}
	local seenExpression = {}
	local seenInstance = {}

	for expression in source:gmatch("require%s*%((.-)%)") do
		if not seenExpression[expression] then
			seenExpression[expression] = true

			local resolved = resolveRequire(instance, expression, aliases)

			local entry = {
				expression = expression,
				resolved = resolved ~= nil,
				full_name = resolved and resolved:GetFullName() or nil
			}

			table.insert(dependencies, entry)

			if resolved and not seenInstance[resolved] then
				seenInstance[resolved] = true
				table.insert(resolvedInstances, resolved)
			end
		end
	end

	return dependencies, resolvedInstances
end

local function determineEntryPoints(functions)
	local result = {}

	for _, name in ipairs(functions) do
		local lowered = string.lower(name)

		if lowered == "init"
			or lowered == "start"
			or lowered == "initialize"
			or lowered == "run"
			or lowered:match("%.init$")
			or lowered:match(":init$")
			or lowered:match("%.start$")
			or lowered:match(":start$")
			or lowered:match("%.initialize$")
			or lowered:match(":initialize$")
		then
			table.insert(result, name)
		end
	end

	return result
end

local function classifyOrigin(instance)
	if instance == ReplicatedStorage or instance:IsDescendantOf(ReplicatedStorage) then
		return "shared"
	end

	if instance == Workspace or instance:IsDescendantOf(Workspace) then
		return "workspace"
	end

	return "client"
end

local function formatStringList(values)
	if #values == 0 then
		return "--   None"
	end

	local lines = {}

	for _, value in ipairs(values) do
		table.insert(lines, "--   " .. tostring(value))
	end

	return table.concat(lines, "\n")
end

local function buildContent(instance, source, sourceMethod, analysis)
	local dependencyLines = {}

	for _, dependency in ipairs(analysis.dependencies) do
		if dependency.resolved then
			table.insert(dependencyLines, dependency.expression .. " -> " .. dependency.full_name)
		else
			table.insert(dependencyLines, dependency.expression .. " -> unresolved")
		end
	end

	local remoteLines = {}

	for _, remote in ipairs(analysis.remote_references) do
		table.insert(remoteLines, remote.class_name .. " " .. remote.full_name)
	end

	local warningLines = {}

	for _, dependency in ipairs(analysis.dependencies) do
		if not dependency.resolved then
			table.insert(warningLines, "Unresolved require: " .. dependency.expression)
		end
	end

	if #warningLines == 0 then
		table.insert(warningLines, "None")
	end

	local header = table.concat({
		"-- Any Dumper Studio Export",
		"-- Script: " .. instance.Name,
		"-- Class: " .. instance.ClassName,
		"-- Path: " .. instance:GetFullName(),
		"-- Origin: " .. classifyOrigin(instance),
		"-- Source Method: " .. sourceMethod,
		"-- Dump Time: " .. os.date("!%Y-%m-%dT%H:%M:%SZ"),
		"",
		source,
		"",
		"-- Analysis",
		"-- Dependencies:",
		formatStringList(dependencyLines),
		"-- Remote References:",
		formatStringList(remoteLines),
		"-- Events / Connections:",
		formatStringList(analysis.events),
		"-- Important Functions:",
		formatStringList(analysis.functions),
		"-- State / Data Access:",
		formatStringList(analysis.state_access),
		"-- Potential Entry Points:",
		formatStringList(analysis.entry_points),
		"-- Warnings:",
		formatStringList(warningLines)
	}, "\n")

	return header
end

local manifest = {
	game = {
		name = game.Name,
		place_id = game.PlaceId,
		game_id = game.GameId,
		dump_time = os.date("!%Y-%m-%dT%H:%M:%SZ")
	},
	environment = {
		type = "Roblox Studio",
		studio_user_id = 0
	},
	scope = "client_static",
	capabilities = {
		script_editor_service = true,
		executor_decompile = false,
		runtime_gc_scan = false,
		filesystem = false
	},
	statistics = {
		scripts_found = 0,
		scripts_dumped = 0,
		scripts_failed = 0,
		modules_found = 0,
		modules_dumped = 0,
		modules_failed = 0,
		remotes_found = #remoteInstances
	},
	scripts = {},
	modules = {},
	remotes = {},
	errors = {}
}

pcall(function()
	manifest.environment.studio_user_id = StudioService:GetUserId()
end)

for _, remote in ipairs(remoteInstances) do
	table.insert(manifest.remotes, {
		name = remote.Name,
		class_name = remote.ClassName,
		full_name = remote:GetFullName()
	})
end

local pending = {}
local queued = {}
local processed = {}

local function queue(instance)
	if not instance or queued[instance] or processed[instance] then
		return
	end

	if not isAllowed(instance) then
		return
	end

	if not isClientScript(instance) and not instance:IsA("ModuleScript") then
		return
	end

	queued[instance] = true
	table.insert(pending, instance)
end

local seedRoots = {
	ReplicatedFirst,
	StarterPlayer,
	StarterGui,
	StarterPack,
	ReplicatedStorage
}

for _, root in ipairs(seedRoots) do
	for _, instance in ipairs(root:GetDescendants()) do
		if isClientScript(instance) then
			queue(instance)
		elseif instance:IsA("ModuleScript") then
			if not instance:IsDescendantOf(ReplicatedStorage) then
				queue(instance)
			end
		end
	end
end

while #pending > 0 do
	local instance = table.remove(pending, 1)
	queued[instance] = nil

	if processed[instance] then
		continue
	end

	processed[instance] = true

	local isModule = instance:IsA("ModuleScript")
	local collection = isModule and manifest.modules or manifest.scripts

	if isModule then
		manifest.statistics.modules_found += 1
	else
		manifest.statistics.scripts_found += 1
	end

	local source, sourceMethod, sourceError = readSource(instance)

	if not source then
		if isModule then
			manifest.statistics.modules_failed += 1
		else
			manifest.statistics.scripts_failed += 1
		end

		table.insert(collection, {
			name = instance.Name,
			class_name = instance.ClassName,
			full_name = instance:GetFullName(),
			origin = classifyOrigin(instance),
			status = "failed",
			error = sourceError
		})

		table.insert(manifest.errors, {
			full_name = instance:GetFullName(),
			error = sourceError
		})

		continue
	end

	local dependencies, resolvedModules = extractDependencies(instance, source)
	local functions = extractFunctions(source)
	local events = extractEvents(source)
	local stateAccess = extractStateAccess(source)
	local remoteReferences = extractRemoteReferences(source)
	local entryPoints = determineEntryPoints(functions)

	local analysis = {
		dependencies = dependencies,
		functions = functions,
		events = events,
		state_access = stateAccess,
		remote_references = remoteReferences,
		entry_points = entryPoints
	}

	for _, dependency in ipairs(resolvedModules) do
		queue(dependency)
	end

	local content = buildContent(instance, source, sourceMethod, analysis)
	local file = createFile(isModule and modulesOutput or scriptsOutput, instance, content)

	local dependencyManifest = {}

	for _, dependency in ipairs(dependencies) do
		table.insert(dependencyManifest, {
			expression = dependency.expression,
			resolved = dependency.resolved,
			full_name = dependency.full_name
		})
	end

	local remoteManifest = {}

	for _, remote in ipairs(remoteReferences) do
		table.insert(remoteManifest, remote.full_name)
	end

	table.insert(collection, {
		name = instance.Name,
		class_name = instance.ClassName,
		full_name = instance:GetFullName(),
		output_path = file:GetFullName(),
		origin = classifyOrigin(instance),
		source_method = sourceMethod,
		status = "success",
		dependencies = dependencyManifest,
		remote_references = remoteManifest,
		events = events,
		important_functions = functions,
		entry_points = entryPoints
	})

	if isModule then
		manifest.statistics.modules_dumped += 1
	else
		manifest.statistics.scripts_dumped += 1
	end
end

local remotesFile = Instance.new("StringValue")
remotesFile.Name = "remotes.json"
remotesFile.Value = HttpService:JSONEncode(manifest.remotes)
remotesFile.Parent = remotesOutput

local manifestFile = Instance.new("StringValue")
manifestFile.Name = "manifest.json"
manifestFile.Value = HttpService:JSONEncode(manifest)
manifestFile.Parent = output

local interesting = {}
local remoteHeavy = {}

local function inspectEntries(entries)
	for _, entry in ipairs(entries) do
		if entry.status == "success" then
			local lowered = string.lower(entry.name)

			if lowered:find("controller", 1, true)
				or lowered:find("combat", 1, true)
				or lowered:find("inventory", 1, true)
				or lowered:find("quest", 1, true)
				or lowered:find("movement", 1, true)
				or lowered:find("data", 1, true)
				or lowered:find("character", 1, true)
			then
				table.insert(interesting, entry.full_name)
			end

			if entry.remote_references and #entry.remote_references > 0 then
				table.insert(remoteHeavy, entry.full_name .. " [" .. #entry.remote_references .. "]")
			end
		end
	end
end

inspectEntries(manifest.scripts)
inspectEntries(manifest.modules)

table.sort(interesting)
table.sort(remoteHeavy)

local indexLines = {
	"Any Dumper Studio Export",
	"",
	"Game: " .. game.Name,
	"PlaceId: " .. tostring(game.PlaceId),
	"Scope: client_static",
	"",
	"Local/Client Scripts Found: " .. manifest.statistics.scripts_found,
	"Local/Client Scripts Dumped: " .. manifest.statistics.scripts_dumped,
	"Local/Client Scripts Failed: " .. manifest.statistics.scripts_failed,
	"Modules Found: " .. manifest.statistics.modules_found,
	"Modules Dumped: " .. manifest.statistics.modules_dumped,
	"Modules Failed: " .. manifest.statistics.modules_failed,
	"Remotes Found: " .. manifest.statistics.remotes_found,
	"",
	"Interesting Scripts:"
}

if #interesting == 0 then
	table.insert(indexLines, "- None")
else
	for _, value in ipairs(interesting) do
		table.insert(indexLines, "- " .. value)
	end
end

table.insert(indexLines, "")
table.insert(indexLines, "Remote-heavy Scripts:")

if #remoteHeavy == 0 then
	table.insert(indexLines, "- None")
else
	for _, value in ipairs(remoteHeavy) do
		table.insert(indexLines, "- " .. value)
	end
end

local indexFile = Instance.new("StringValue")
indexFile.Name = "INDEX.txt"
indexFile.Value = table.concat(indexLines, "\n")
indexFile.Parent = output

print("Any Dumper finished")
print("Output:", output:GetFullName())
print("Scripts:", manifest.statistics.scripts_dumped, "/", manifest.statistics.scripts_found)
print("Modules:", manifest.statistics.modules_dumped, "/", manifest.statistics.modules_found)
print("Remotes:", manifest.statistics.remotes_found)
