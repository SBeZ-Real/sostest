local function countRoot(entry)
    local root = entry.Root()
    if not root then
        return {Scripts = 0, Remotes = 0, Total = 0}
    end
    local scripts = 0
    local remotes = 0
    local total = 0
    local items = {root}
    local ok, descendants = pcall(function()
        return root:GetDescendants()
    end)
    if ok and type(descendants) == "table" then
        for _, child in ipairs(descendants) do
            items[#items + 1] = child
        end
    end
    for index, instance in ipairs(items) do
        if state.Cancelled then
            break
        end
        local allowed, reason = instanceAllowed(instance, entry, root)
        if allowed then
            if isLua(instance) then
                scripts = scripts + 1
            elseif isRemote(instance) then
                remotes = remotes + 1
            end
            total = total + 1
        else
            reject(reason)
        end
        if index % 800 == 0 then
            task.wait()
        end
    end
    return {Scripts = scripts, Remotes = remotes, Total = total}
end

local function scanStructure()
    if state.Running or state.Scanning then
        return
    end
    state.Scanning = true
    state.Cancelled = false
    state.Phase = "SCANNING STRUCTURE"
    state.ScanReady = false
    scanCache = {}
    resetFilterStats()
    state.Game = getGameName()
    state.PlaceId = game.PlaceId
    setText(ui.gameLine, state.Game .. "  ·  " .. tostring(state.PlaceId) .. "  ·  " .. state.Mode)
