local function writeOutputs()
    local started = os.clock()
    state.Phase = "WRITING"
    updateUI()
    local indexText = "return " .. serialize(indexRows)
    local remoteText = "return " .. serialize(remoteRows)
    local runtimeText = "return " .. serialize(runtimeRows)
    local files = {
        {"_INDEX.luau", indexText},
        {"_REMOTE_MAP.luau", remoteText},
        {"_RUNTIME_INDEX.luau", runtimeText},
        {"_FILTER_REPORT.txt", buildFilterReport()},
        {"_ERROR_LOG.txt", buildErrorLog()}
    }
    if options.FullDump then
        local parts = {"return {"}
        for _, row in ipairs(fullDumpRows) do
            parts[#parts + 1] = "{FullName=" .. luaQuote(row.FullName) .. ",Root=" .. luaQuote(row.Root) .. ",Source=" .. longQuote(row.Source) .. "},"
        end
        parts[#parts + 1] = "}"
