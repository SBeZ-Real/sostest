local function safeString(value)
    local ok, result = pcall(tostring, value)
    return ok and result or "<unprintable>"
end

local function sanitize(value)
    local s = safeString(value)
    s = s:gsub("[%z\1-\31]", "_")
    s = s:gsub("[<>:\"/\\|%?%*]", "_")
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    s = s:gsub("[%. ]+$", "")
    if s == "" then
        s = "unnamed"
    end
    if #s > 72 then
        local hash = 5381
        for i = 1, #s do
            hash = (hash * 33 + string.byte(s, i)) % 4294967296
        end
        s = s:sub(1, 56) .. "_" .. string.format("%08x", hash)
    end
    return s
end

local function hashText(text)
    local hash = 2166136261
    for i = 1, #text do
        hash = bit32.bxor(hash, string.byte(text, i))
        hash = (hash * 16777619) % 4294967296
    end
    return string.format("%08x", hash)
end

local function luaQuote(value)
    return string.format("%q", safeString(value))
end

local function longQuote(text)
    local content = tostring(text or "")
    for level = 0, 12 do
        local eq = string.rep("=", level)
        local close = "]" .. eq .. "]"
        if not string.find(content, close, 1, true) then
            return "[" .. eq .. "[" .. content .. close
        end
    end
    return luaQuote(content)
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local kind = typeof and typeof(value) or type(value)
    if kind == "nil" then
        return "nil"
    end
    if kind == "boolean" or kind == "number" then
        return tostring(value)
    end
    if kind == "string" then
        return luaQuote(value)
    end
    if kind == "Instance" then
        local full = safeString(value)
        pcall(function()
            full = value:GetFullName()
        end)
        return luaQuote(full)
    end
    if kind ~= "table" then
        return luaQuote(safeString(value))
    end
    if seen[value] then
        return luaQuote("<cycle>")
    end
    if depth >= 6 then
        return luaQuote("<max-depth>")
    end
    seen[value] = true
    local parts = {"{"}
    local count = 0
    for key, child in pairs(value) do
        count = count + 1
        if count > 500 then
            parts[#parts + 1] = "[\"__TRUNCATED\"]=true,"
            break
        end
        local encodedKey
        if type(key) == "string" and key:match("^[%a_][%w_]*$") then
            encodedKey = key
        else
            encodedKey = "[" .. serialize(key, depth + 1, seen) .. "]"
        end
        parts[#parts + 1] = encodedKey .. "=" .. serialize(child, depth + 1, seen) .. ","
    end
    parts[#parts + 1] = "}"
    seen[value] = nil
    return table.concat(parts)
end

local function jsonSafe(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local kind = typeof and typeof(value) or type(value)
    if kind == "nil" then
        return nil
    end
    if kind == "boolean" or kind == "number" or kind == "string" then
        return value
    end
    if kind == "Instance" then
        local full = safeString(value)
        pcall(function()
            full = value:GetFullName()
        end)
        return full
    end
    if kind ~= "table" then
        return safeString(value)
    end
    if seen[value] or depth >= 5 then
        return safeString(value)
    end
    seen[value] = true
    local out = {}
    local count = 0
    for key, child in pairs(value) do
        count = count + 1
        if count > 250 then
            out.__TRUNCATED = true
            break
        end
        out[safeString(key)] = jsonSafe(child, depth + 1, seen)
    end
    seen[value] = nil
    return out
end

