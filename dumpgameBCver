local function ensureFolder(path)
    if not caps.makefolder then
        return false, "makefolder unavailable"
    end
    local current = ""
    for segment in string.gmatch(path, "[^/]+") do
        current = current == "" and segment or current .. "/" .. segment
        local exists = false
        if caps.isfolder then
            local ok, result = pcall(isfolderFn, current)
            exists = ok and result == true
        end
        if not exists then
            local ok, err = pcall(makefolderFn, current)
            if not ok and caps.isfolder then
                local ok2, exists2 = pcall(isfolderFn, current)
                if not ok2 or not exists2 then
                    return false, safeString(err)
                end
            end
        end
    end
    return true
end

local function parentFolder(path)
    return path:match("^(.*)/[^/]+$")
end

local function uniquePath(path)
    if not usedPaths[path] then
        usedPaths[path] = true
        return path
    end
    local base, ext = path:match("^(.*)(%.[^%./]+)$")
    base = base or path
    ext = ext or ""
    local index = 2
    local candidate = base .. "_" .. tostring(index) .. ext
    while usedPaths[candidate] do
        index = index + 1
        candidate = base .. "_" .. tostring(index) .. ext
    end
    usedPaths[candidate] = true
    return candidate
end

local function writeVerified(path, data)
    if not caps.writefile then
        return false, "writefile unavailable"
    end
    local folder = parentFolder(path)
    if folder then
        local okFolder, folderErr = ensureFolder(folder)
        if not okFolder then
            return false, folderErr
        end
    end
    local okWrite, writeErr = pcall(writefileFn, path, data)
    if not okWrite then
        return false, safeString(writeErr)
    end
    if caps.readfile then
        local okRead, readBack = pcall(readfileFn, path)
        if not okRead then
            return false, "verify read failed: " .. safeString(readBack)
        end
        if readBack ~= data then
            return false, "verify content mismatch"
        end
    elseif caps.isfile then
        local okFile, exists = pcall(isfileFn, path)
        if not okFile or not exists then
            return false, "verify file missing"
        end
    end
    return true
end

