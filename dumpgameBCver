local function executeAuditInternal(overrideMode)
    local currentMode = overrideMode or AppState.ScanMode
    local startTime = os.clock()

    progressFill.Size = UDim2.new(0, 0, 1, 0)
    percentLabel.Text = string.format("CHECKING BACKDOORS [%s MODE]...", currentMode)

    local report = {
        GameTitle = placeTitle,
        PlaceId = placeId,
        ScanTimestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        ScanMode = (currentMode == "SMART" and "SMART_AUDIT") or ((currentMode == "FULL" and "FULL_GAME") or "TARGETED"),
        Scope = (currentMode == "SMART" and "FILTERED_TARGET_REGISTRY") or ((currentMode == "FULL" and "ALL_ACCESSIBLE_AUDIT_DESCENDANTS") or "SELECTED_TARGET"),
        DurationSeconds = 0,
        TotalScriptsScanned = 0,
        TotalRemotesScanned = 0,
        AuditSummary = {
            CleanThreatCount = 0,
            LowThreatCount = 0,
            MediumThreatCount = 0,
            HighThreatCount = 0,
            AnalysisFailedCount = 0,
            UnscannedCount = 0
        },
        SuspiciousRemotes = {},
        SuspiciousScripts = {}
    }

    local scriptsToAudit = {}
    local remoteTargets = {}

    if currentMode == "TARGETED" then
        if not AppState.Selected then
            percentLabel.Text = "NO TARGET SCRIPT SELECTED"
            return
        end
        scriptsToAudit = { AppState.Selected }
        remoteTargets = {}
    else
        scriptsToAudit = collectScriptTargets(currentMode)
        remoteTargets = collectRemoteTargets(currentMode)
        AppState.Registry = scriptsToAudit
    end

    local totalScanned = #scriptsToAudit
    local remotesScanned = #remoteTargets
    report.TotalScriptsScanned = totalScanned
    report.TotalRemotesScanned = remotesScanned

    for _, remote in ipairs(remoteTargets) do
        local threat = analyzeBackdoorThreat(remote, "", "SOURCE")
        if threat.Score >= 40 then
            table.insert(report.SuspiciousRemotes, {
                Name = remote.Name,
                Class = remote.ClassName,
                Path = remote:GetFullName(),
                Score = threat.Score,
                Level = threat.Level,
                Reasons = threat.Reasons
            })
        end
    end

    local cleanCount, lowCount, medCount, highCount, failedCount = 0, 0, 0, 0, 0

    for idx, entry in ipairs(scriptsToAudit) do
        local code = entry.ResolvedCode
        local method = entry.Method
        if not code or method == "PENDING" then
            code, method = resolveSource(entry.Instance)
            entry.ResolvedCode = code
            entry.Method = method
            if method == "FAILED" then
                entry.Hash = "UNAVAILABLE"
            else
                entry.Hash = computeHash(code)
            end
        end
        local threat = analyzeBackdoorThreat(entry.Instance, code, method)
        entry.Threat = threat
        AppState.RegistryCache[entry.Instance] = entry

        if threat.Level == "HIGH" then
            highCount = highCount + 1
        elseif threat.Level == "MEDIUM" then
            medCount = medCount + 1
        elseif threat.Level == "LOW" then
            lowCount = lowCount + 1
        elseif threat.Level == "ANALYSIS_FAILED" then
            failedCount = failedCount + 1
        else
            cleanCount = cleanCount + 1
        end

        if threat.Score >= 40 then
            table.insert(report.SuspiciousScripts, {
                Name = entry.Instance.Name,
                Path = entry.FullPath,
                CanonicalId = entry.CanonicalId,
                Origin = entry.Origin,
                Score = threat.Score,
                Level = threat.Level,
                Reasons = threat.Reasons
            })
        end

        local ratio = idx / math.max(1, totalScanned)
        progressFill.Size = UDim2.new(ratio, 0, 1, 0)
        percentLabel.Text = string.format("%s CHECK %d%% (%d/%d)", currentMode, math.floor(ratio * 100), idx, totalScanned)
        if idx % 12 == 0 then
            task.wait()
        end
    end

    local duration = math.floor((os.clock() - startTime) * 100) / 100
    report.DurationSeconds = duration
    report.AuditSummary.CleanThreatCount = cleanCount
    report.AuditSummary.LowThreatCount = lowCount
    report.AuditSummary.MediumThreatCount = medCount
    report.AuditSummary.HighThreatCount = highCount
    report.AuditSummary.AnalysisFailedCount = failedCount
    report.AuditSummary.UnscannedCount = math.max(0, totalScanned - (cleanCount + lowCount + medCount + highCount + failedCount))

    if currentMode == "TARGETED" then
        statsOverview.Text = string.format("1 SCRIPT   0 REMOTES\nTARGETED: %s | THREAT: %s (%d)", cleanString(AppState.Selected.Instance.Name), AppState.Selected.Threat.Level, AppState.Selected.Threat.Score)
        AppState.LastTargetedResult = {
            Selected = AppState.Selected,
            Report = report,
            Duration = duration
        }
    else
        AppState.Stats.TotalScripts = totalScanned
        AppState.Stats.TotalRemotes = remotesScanned
        AppState.Stats.Unscanned = report.AuditSummary.UnscannedCount
        AppState.Stats.Clean = cleanCount
        AppState.Stats.Low = lowCount
        AppState.Stats.Medium = medCount
        AppState.Stats.High = highCount
        AppState.Stats.Failed = failedCount
        statsOverview.Text = string.format("%d SCRIPTS   %d REMOTES\nCLEAN %d   LOW %d   MED %d   HIGH %d   FAIL %d", totalScanned, remotesScanned, cleanCount, lowCount, medCount, highCount, failedCount)
        
        AppState.LastSnapshot = {
            Identity = {
                PlaceId = placeId,
                GameId = gameId,
                JobId = jobId,
                PlaceVersion = placeVersion
            },
            Mode = currentMode,
            Scope = report.Scope,
            Scripts = {},
            Remotes = {}
        }
        for _, item in ipairs(scriptsToAudit) do
            AppState.LastSnapshot.Scripts[item.CanonicalId] = {
                Name = item.Instance.Name,
                FullPath = item.FullPath,
                Length = (item.Method == "FAILED" or item.Hash == "UNAVAILABLE") and 0 or (item.ResolvedCode and #item.ResolvedCode or 0),
                Hash = item.Hash or (item.Method == "FAILED" and "UNAVAILABLE" or computeHash(item.ResolvedCode or "")),
                ThreatLevel = item.Threat and item.Threat.Level or "UNSCANNED",
                ThreatScore = item.Threat and item.Threat.Score or 0,
                Confidence = item.Threat and item.Threat.Confidence or "NONE",
                Method = item.Method or "PENDING",
                ReasonsCount = item.Threat and #item.Threat.Reasons or 0,
                ReasonFingerprint = buildReasonFingerprint(item.Threat)
            }
        end
        for _, rem in ipairs(remoteTargets) do
            local fName = rem.Name
            pcall(function() fName = rem:GetFullName() end)
            AppState.LastSnapshot.Remotes[fName] = {
                Class = rem.ClassName
            }
        end
    end

    safeMakeDir(rootDirectory)
    local okJson, encoded = pcall(HttpService.JSONEncode, HttpService, report)
    if okJson then
        writeText(backdoorFilePath, encoded)
    end

    local humanReportText = formatAuditSummaryReport(report)
    writeText(humanReportFilePath, humanReportText)

    table.insert(AppState.History, {
        Timestamp = os.date("%H:%M:%S"),
        Mode = currentMode,
        Scope = report.Scope,
        Duration = duration,
        Scripts = totalScanned,
        Remotes = remotesScanned,
        Suspicious = #report.SuspiciousScripts + #report.SuspiciousRemotes,
        Clean = cleanCount,
        Low = lowCount,
        Medium = medCount,
        High = highCount,
        Failed = failedCount,
        Unscanned = report.AuditSummary.UnscannedCount
    })

    percentLabel.Text = string.format("CHECK COMPLETE (%.2fs) | SAVED: %s", duration, backdoorFilePath)
    if AppState.Selected then
        updatePreview(AppState.Selected)
    end
    filterDataset()
end

