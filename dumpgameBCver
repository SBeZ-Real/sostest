local function isDefaultLocalObject(instance)
    if not LocalPlayer then
        return false
    end
    local cursor = instance
    local guard = 0
    while cursor and guard < 80 do
        local parent = safeParent(cursor)
        if parent == LocalPlayer then
            break
        end
        local name = safeString(cursor.Name)
        if defaultNames[name] then
            return true
        end
        cursor = parent
        guard = guard + 1
    end
    return false
end

