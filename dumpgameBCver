local function switchTab(tabKey)
    AppState.InspectorTab = tabKey
    for k, tabObj in pairs(tabButtons) do
        local active = (k == tabKey)
        tabObj.Button.BackgroundColor3 = active and COLORS.PanelAlt or COLORS.Panel
        tabObj.Button.TextColor3 = active and COLORS.BlueLight or COLORS.TextDim
        tabObj.Stroke.Color = active and COLORS.BlueDark or COLORS.Border
    end
    detailsPanel.Visible = (tabKey == "DETAILS")
    codePanel.Visible = (tabKey == "CODE")
    detectionsPanel.Visible = (tabKey == "DETECTIONS")
    if AppState.Selected then
        updatePreview(AppState.Selected)
    end
end

for k, tabObj in pairs(tabButtons) do
    tabObj.Button.MouseButton1Click:Connect(function()
        switchTab(k)
    end)
end

local function setMode(modeKey)
    if AppState.IsRunning then return end
    if modeKey == "TARGETED" and not AppState.Selected then
        percentLabel.Text = "TARGETED MODE: PLEASE SELECT A SCRIPT FIRST"
        return
    end
    AppState.ScanMode = modeKey
    for k, btn in pairs(modeButtons) do
        local active = (k == modeKey)
        btn.BackgroundColor3 = active and COLORS.BlueDark or COLORS.Panel
        btn.TextColor3 = active and COLORS.Text or COLORS.TextDim
    end
    if modeKey == "TARGETED" then
        if AppState.Selected then
            AppState.Registry = { AppState.Selected }
            statsOverview.Text = string.format("1 SCRIPT   0 REMOTES\nTARGETED: %s", cleanString(AppState.Selected.Instance.Name))
            filterDataset()
        end
    else
        collectTargets()
    end
end

