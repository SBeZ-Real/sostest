local function resolveRoots()
    for _, descriptor in ipairs(rootDescriptors) do
        local ok, result = pcall(descriptor.Resolve)
        descriptor.Instance = ok and result or nil
    end
end

local function descriptorFor(instance)
    local candidates = {}
    for _, descriptor in ipairs(rootDescriptors) do
        if descriptor.Selected and descriptor.Instance and (instance == descriptor.Instance or descendant(instance, descriptor.Instance)) then
            candidates[#candidates + 1] = descriptor
        end
    end
    table.sort(candidates, function(a, b)
        if a.Group ~= b.Group then
            return a.Group == "Local Player"
        end
        if a.Key == "Character" then
            return true
        end
        if b.Key == "Character" then
            return false
        end
        return #safeFullName(a.Instance) > #safeFullName(b.Instance)
    end)
    for _, descriptor in ipairs(candidates) do
        local allowed, reason = instanceAllowed(instance, descriptor)
        if allowed then
            return descriptor, reason
        end
        recordReject(reason)
    end
end

