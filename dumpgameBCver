function __CBX.serializeValue(value, depth, seen, maxItems)
    depth = depth or 0
    seen = seen or {}
    maxItems = maxItems or 64
    local luaType = type(value)
    local robloxType = typeof(value)
    if luaType == "string" then
        return quoteString(value)
    end
    if luaType == "number" then
        if value ~= value then return "0/0" end
        if value == math.huge then return "math.huge" end
        if value == -math.huge then return "-math.huge" end
        return tostring(value)
    end
    if luaType == "boolean" or luaType == "nil" then
        return tostring(value)
    end
    if robloxType == "Instance" then
        return quoteString(string.format("Instance<%s>", __CBX.safeFullName(value)))
    end
    if robloxType == "Vector2" then
        return string.format("Vector2.new(%s, %s)", tostring(value.X), tostring(value.Y))
    end
    if robloxType == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", tostring(value.X), tostring(value.Y), tostring(value.Z))
    end
    if robloxType == "Color3" then
        return string.format("Color3.new(%s, %s, %s)", tostring(value.R), tostring(value.G), tostring(value.B))
    end
    if robloxType == "CFrame" then
        local ok, values = pcall(function() return { value:GetComponents() } end)
        if ok then
            local parts = {}
            for i, item in ipairs(values) do parts[i] = tostring(item) end
            return "CFrame.new(" .. table.concat(parts, ", ") .. ")"
        end
    end
    if robloxType == "UDim" then
        return string.format("UDim.new(%s, %s)", tostring(value.Scale), tostring(value.Offset))
    end
    if robloxType == "UDim2" then
        return string.format("UDim2.new(%s, %s, %s, %s)", tostring(value.X.Scale), tostring(value.X.Offset), tostring(value.Y.Scale), tostring(value.Y.Offset))
    end
    if robloxType == "EnumItem" or robloxType == "BrickColor" or robloxType == "NumberRange" or robloxType == "Rect" or robloxType == "Ray" then
        return quoteString(tostring(value))
    end
    if luaType == "function" then
        local info = __CBX.getFunctionInfo(value)
        return quoteString(string.format("function<%s|%s>", tostring(info.name or "anonymous"), tostring(info.source or "unknown")))
    end
    if luaType == "table" then
        if seen[value] then
            return quoteString("<cycle>")
        end
        if depth >= 5 then
            return quoteString("<depth-limit>")
        end
        seen[value] = true
        local items = {}
        local count = 0
        local ok = pcall(function()
            for k, v in pairs(value) do
                count = count + 1
                if count > maxItems then break end
                table.insert(items, {
                    Key = __CBX.serializeValue(k, depth + 1, seen, maxItems),
                    Value = __CBX.serializeValue(v, depth + 1, seen, maxItems)
                })
            end
        end)
        seen[value] = nil
        if not ok then
            return quoteString("<table-read-failed>")
        end
        table.sort(items, function(a, b) return a.Key < b.Key end)
        local out = {}
        for _, item in ipairs(items) do
            table.insert(out, string.format("[%s] = %s", item.Key, item.Value))
        end
        if count > maxItems then
            table.insert(out, string.format("[%s] = %s", quoteString("__TRUNCATED"), tostring(count - maxItems)))
        end
        return "{" .. table.concat(out, ", ") .. "}"
    end
    return quoteString(string.format("%s<%s>", robloxType, tostring(value)))
end

function __CBX.normalizeValue(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local luaType = type(value)
    local robloxType = typeof(value)
    if luaType == "nil" or luaType == "string" or luaType == "boolean" then
        return value
    end
    if luaType == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return tostring(value)
        end
        return value
    end
    if robloxType == "Instance" then
        return { Type = "Instance", Class = value.ClassName, Path = __CBX.safeFullName(value) }
    end
    if luaType == "function" then
        local info = __CBX.getFunctionInfo(value)
        return { Type = "function", Name = tostring(info.name or "anonymous"), Source = tostring(info.source or "unknown") }
    end
    if luaType == "table" then
        if seen[value] then return "<cycle>" end
        if depth >= 4 then return "<depth-limit>" end
        seen[value] = true
        local out = {}
        local count = 0
        pcall(function()
            for k, v in pairs(value) do
                count = count + 1
                if count > 80 then break end
                out[tostring(k)] = __CBX.normalizeValue(v, depth + 1, seen)
            end
        end)
        seen[value] = nil
        if count > 80 then out.__TRUNCATED = count - 80 end
        return out
    end
    return { Type = robloxType, Value = tostring(value) }
end

