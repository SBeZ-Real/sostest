    table.insert(lines, string.format("MEDIUM THREAT     : %d", report.AuditSummary.MediumThreatCount))
    table.insert(lines, string.format("HIGH THREAT       : %d", report.AuditSummary.HighThreatCount))
    table.insert(lines, string.format("ANALYSIS FAILED   : %d", report.AuditSummary.AnalysisFailedCount))
    table.insert(lines, string.format("UNSCANNED         : %d", report.AuditSummary.UnscannedCount))
    table.insert(lines, "--------------------------------------------------------------------------------")
    table.insert(lines, "FLAGGED SCRIPTS")
    table.insert(lines, "--------------------------------------------------------------------------------")
    if #report.SuspiciousScripts == 0 then
        table.insert(lines, "No suspicious scripts identified by heuristic baseline rules.")
    else
        for idx, item in ipairs(report.SuspiciousScripts) do
            table.insert(lines, string.format("[%d] %s (%s) - Threat: %s (%d)", idx, item.Name, item.Path, item.Level, item.Score))
            for _, r in ipairs(item.Reasons) do
                table.insert(lines, string.format("    + %s", r.Desc))
            end
        end
    end
    table.insert(lines, "--------------------------------------------------------------------------------")
    table.insert(lines, "FLAGGED REMOTES")
    table.insert(lines, "--------------------------------------------------------------------------------")
    if #report.SuspiciousRemotes == 0 then
        table.insert(lines, "No suspicious network remotes detected.")
    else
        for idx, item in ipairs(report.SuspiciousRemotes) do
            table.insert(lines, string.format("[%d] %s (%s) - Threat: %s (%d)", idx, item.Name, item.Path, item.Level, item.Score))
            for _, r in ipairs(item.Reasons) do
                table.insert(lines, string.format("    + %s", r.Desc))
            end
        end
    end
    table.insert(lines, "================================================================================")
    table.insert(lines, "Generated by Colors - Blue")
    table.insert(lines, "================================================================================")
    return table.concat(lines, "\n")
end

