local function wrapSource(code)
    local level = 2
    while true do
        local closeToken = "]" .. string.rep("=", level) .. "]"
        if not code:find(closeToken, 1, true) then
            local openToken = "[" .. string.rep("=", level) .. "["
            return openToken .. "\n" .. code .. "\n" .. closeToken
        end
        level = level + 1
    end
end

