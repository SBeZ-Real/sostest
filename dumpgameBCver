function __CBX.exportRemoteMap(mode)
    local records = {}
    for index, remote in ipairs(collectRemoteTargets(mode)) do
        records[index] = __CBX.buildRemoteRecord(remote)
        if index % 30 == 0 then task.wait() end
    end
    local payload = {
        PlaceId = placeId,
        JobId = jobId,
        Timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        Count = #records,
        Remotes = records
    }
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if ok then writeText(string.format("%s/_REMOTE_MAP.json", rootDirectory), encoded) end
    return records
end

function __CBX.getFunctionOwner(fn)
    if not __CBX.getEnvFunc then return nil end
    local owner = nil
    pcall(function()
        local env = __CBX.getEnvFunc(fn)
        if type(env) == "table" then
            local candidate = rawget(env, "script")
            if typeof(candidate) == "Instance" then owner = candidate end
        end
    end)
    return owner
end

function __CBX.exportRuntimeClosures(mode)
    if not __CBX.getGCFunc then return 0 end
    local objects = {}
    local ok = pcall(function() objects = __CBX.getGCFunc(true) or {} end)
    if not ok then return 0 end
    local chunks = {}
    local count = 0
    local scanned = 0
    local seen = {}
    local maxClosures = mode == "FULL" and 6000 or 2500
    for _, value in pairs(objects) do
        scanned = scanned + 1
        if type(value) == "function" and not seen[value] then
            seen[value] = true
            local isLua = true
            if __CBX.isLClosureFunc then pcall(function() isLua = __CBX.isLClosureFunc(value) end) end
            if isLua then
                local owner = __CBX.getFunctionOwner(value)
                local info = __CBX.getFunctionInfo(value)
                local source = tostring(info.source or info.short_src or "")
                local include = mode == "FULL" or owner ~= nil or (source ~= "" and source ~= "=[C]")
                if include then
                    count = count + 1
                    local ownerPath = owner and __CBX.safeFullName(owner) or "UNRESOLVED"
                    table.insert(chunks, string.format("RUNTIME_CLOSURE_INDEX = %d\nOWNER = %s\nINFO = %s\nDATA_BEGIN\nlocal RUNTIME_CLOSURE = %s\nreturn RUNTIME_CLOSURE\nDATA_END\n%s", count, quoteString(ownerPath), __CBX.serializeValue(info, 0, {}, 50), inspectFunction(value, 0, {}), string.rep("-", 80)))
                    if count >= maxClosures then break end
                end
            end
        end
        if scanned % 200 == 0 then task.wait() end
    end
    if count > 0 then
        writeText(string.format("%s/_RUNTIME_CLOSURES.luau", rootDirectory), table.concat(chunks, "\n"))
    end
    return count
end

__CBX.RuntimeTrace = {
    Enabled = false,
    Hooked = false,
    OldNamecall = nil,
    Events = {},
    InboundConnections = {},
    InboundFunctionOriginals = {},
    MaxEvents = 12000,
    Dropped = 0,
    StartedAt = nil
}

function __CBX.pushRuntimeTrace(direction, remote, method, args, results)
    if #__CBX.RuntimeTrace.Events >= __CBX.RuntimeTrace.MaxEvents then
        __CBX.RuntimeTrace.Dropped = __CBX.RuntimeTrace.Dropped + 1
        return
    end
    local caller = nil
    if __CBX.getCallingScriptFunc then pcall(function() caller = __CBX.getCallingScriptFunc() end) end
    local callerState = nil
    if __CBX.checkCallerFunc then pcall(function() callerState = __CBX.checkCallerFunc() end) end
    table.insert(__CBX.RuntimeTrace.Events, {
        Time = os.clock(),
        Direction = direction,
        Method = method,
        Remote = __CBX.safeFullName(remote),
        Class = getClassName(remote),
        Caller = caller and __CBX.safeFullName(caller) or nil,
        CheckCaller = callerState,
        Args = __CBX.normalizeValue(args),
        Results = __CBX.normalizeValue(results)
    })
end
function __CBX.installNamecallTrace()
    if __CBX.RuntimeTrace.Hooked then return true end
    if not __CBX.hookMetaMethodFunc or not __CBX.getNamecallMethodFunc then return false, "NAMECALL_HOOK_UNAVAILABLE" end
    local old = nil
    local fallbackOld = nil
    if __CBX.getRawMetatableFunc then
        pcall(function()
            local mt = __CBX.getRawMetatableFunc(game)
            if type(mt) == "table" then fallbackOld = rawget(mt, "__namecall") end
        end)
    end
    local function handler(self, ...)
        local method = nil
        pcall(function() method = __CBX.getNamecallMethodFunc() end)
        local className = ""
        if typeof(self) == "Instance" then pcall(function() className = self.ClassName end) end
        local target = old or fallbackOld
        if type(target) ~= "function" then return nil end
        local shouldTrace = __CBX.RuntimeTrace.Enabled and (className == "RemoteEvent" or className == "RemoteFunction" or className == "UnreliableRemoteEvent") and (method == "FireServer" or method == "InvokeServer")
        if shouldTrace then
            local args = table.pack(...)
            if method == "InvokeServer" then
                local results = table.pack(target(self, ...))
                __CBX.pushRuntimeTrace("OUT", self, method, args, results)
                return table.unpack(results, 1, results.n)
            end
            __CBX.pushRuntimeTrace("OUT", self, method, args, nil)
        end
        return target(self, ...)
    end
    local wrapped = handler
    if __CBX.newCClosureFunc then
        local okWrap, resultWrap = pcall(__CBX.newCClosureFunc, handler)
        if okWrap and type(resultWrap) == "function" then wrapped = resultWrap end
    end
    local ok, result = pcall(function() return __CBX.hookMetaMethodFunc(game, "__namecall", wrapped) end)
    if not ok then return false, tostring(result) end
    if type(result) == "function" then old = result end
    if type(old) ~= "function" and type(fallbackOld) == "function" then old = fallbackOld end
    if type(old) ~= "function" then return false, "NAMECALL_ORIGINAL_UNAVAILABLE" end
    __CBX.RuntimeTrace.OldNamecall = old
    __CBX.RuntimeTrace.Hooked = true
    return true
end
function __CBX.attachInboundTrace()
    for _, connection in ipairs(__CBX.RuntimeTrace.InboundConnections) do pcall(function() connection:Disconnect() end) end
    __CBX.RuntimeTrace.InboundConnections = {}
    __CBX.RuntimeTrace.InboundFunctionOriginals = {}
    for _, remote in ipairs(collectRemoteTargets("FULL")) do
        if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
            local ok, connection = pcall(function()
                return remote.OnClientEvent:Connect(function(...)
                    if __CBX.RuntimeTrace.Enabled then __CBX.pushRuntimeTrace("IN", remote, "OnClientEvent", table.pack(...), nil) end
                end)
            end)
            if ok and connection then table.insert(__CBX.RuntimeTrace.InboundConnections, connection) end
        elseif remote:IsA("RemoteFunction") then
            local original = nil
            pcall(function() original = remote.OnClientInvoke end)
            if type(original) == "function" then
                __CBX.RuntimeTrace.InboundFunctionOriginals[remote] = original
                pcall(function()
                    remote.OnClientInvoke = function(...)
                        local args = table.pack(...)
                        local results = table.pack(original(...))
                        if __CBX.RuntimeTrace.Enabled then __CBX.pushRuntimeTrace("IN", remote, "OnClientInvoke", args, results) end
                        return table.unpack(results, 1, results.n)
                    end
                end)
            end
        end
    end
end
function __CBX.saveRuntimeTrace()
    safeMakeDir(rootDirectory)
    local payload = {
        PlaceId = placeId,
        GameId = gameId,
        JobId = jobId,
        StartedAt = __CBX.RuntimeTrace.StartedAt,
        StoppedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        EventCount = #__CBX.RuntimeTrace.Events,
        Dropped = __CBX.RuntimeTrace.Dropped,
        Events = __CBX.RuntimeTrace.Events
    }
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if ok then return writeText(string.format("%s/_REMOTE_TRACE.json", rootDirectory), encoded) end
    return false, "TRACE_JSON_FAILED"
end

function __CBX.startRuntimeCapture()
    local ok, err = __CBX.installNamecallTrace()
    if not ok then return false, err end
    __CBX.RuntimeTrace.Events = {}
    __CBX.RuntimeTrace.Dropped = 0
    __CBX.RuntimeTrace.StartedAt = os.date("!%Y-%m-%dT%H:%M:%SZ")
    __CBX.RuntimeTrace.Enabled = true
    __CBX.attachInboundTrace()
    return true
end

function __CBX.stopRuntimeCapture()
    __CBX.RuntimeTrace.Enabled = false
    for _, connection in ipairs(__CBX.RuntimeTrace.InboundConnections) do pcall(function() connection:Disconnect() end) end
    __CBX.RuntimeTrace.InboundConnections = {}
    for remote, original in pairs(__CBX.RuntimeTrace.InboundFunctionOriginals) do
        pcall(function()
            if remote.Parent ~= nil then remote.OnClientInvoke = original end
        end)
    end
    __CBX.RuntimeTrace.InboundFunctionOriginals = {}
    return __CBX.saveRuntimeTrace()
end
