local function sanitize(value)
    local s = safeString(value)
    s = s:gsub("[%z\1-\31]", "_")
    s = s:gsub("[<>:\"/\\|%?%*]", "_")
    s = s:gsub("^%s+", "")
    s = s:gsub("[%s%.]+$", "")
    if s == "" then
        s = "unnamed"
    end
    if reserved[string.upper(s)] then
        s = s .. "_"
    end
    if #s > 80 then
        s = s:sub(1, 62) .. "_" .. shortHash(s)
    end
    return s
end

local function luaQuote(value)
    return string.format("%q", safeString(value))
end

local function longQuote(text)
    local content = safeString(text or "")
    for level = 0, 12 do
        local eq = string.rep("=", level)
        local close = "]" .. eq .. "]"
        if not string.find(content, close, 1, true) then
            return "[" .. eq .. "[" .. content .. close
        end
    end
    return luaQuote(content)
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local kind = typeof and typeof(value) or type(value)
    if kind == "nil" then
        return "nil"
    end
    if kind == "boolean" or kind == "number" then
        return tostring(value)
    end
    if kind == "string" then
        return luaQuote(value)
    end
    if kind == "Instance" then
        local full = safeString(value)
        pcall(function()
            full = value:GetFullName()
        end)
        return luaQuote(full)
    end
    if kind ~= "table" then
        return luaQuote(safeString(value))
    end
    if seen[value] then
        return luaQuote("<cycle>")
    end
    if depth >= 6 then
        return luaQuote("<max-depth>")
    end
    seen[value] = true
    local parts = {"{"}
    local count = 0
    for key, child in pairs(value) do
        count = count + 1
        if count > 500 then
            parts[#parts + 1] = "[\"__TRUNCATED\"]=true,"
            break
        end
        local keyText
        if type(key) == "string" and key:match("^[%a_][%w_]*$") then
            keyText = key
        else
            keyText = "[" .. serialize(key, depth + 1, seen) .. "]"
        end
        parts[#parts + 1] = keyText .. "=" .. serialize(child, depth + 1, seen) .. ","
    end
    parts[#parts + 1] = "}"
    seen[value] = nil
    return table.concat(parts)
end

local function jsonSafe(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local kind = typeof and typeof(value) or type(value)
    if kind == "nil" then
        return nil
    end
    if kind == "boolean" or kind == "number" or kind == "string" then
        return value
    end
    if kind == "Instance" then
        local full = safeString(value)
        pcall(function()
            full = value:GetFullName()
        end)
        return full
    end
    if kind ~= "table" then
        return safeString(value)
    end
    if seen[value] or depth >= 5 then
        return safeString(value)
    end
    seen[value] = true
    local out = {}
    local count = 0
    for key, child in pairs(value) do
        count = count + 1
        if count > 250 then
            out.__TRUNCATED = true
            break
        end
        out[safeString(key)] = jsonSafe(child, depth + 1, seen)
    end
    seen[value] = nil
    return out
end

local function safeParent(instance)
    local parent
    pcall(function()
        parent = instance.Parent
    end)
    return parent
end

local function safeClass(instance)
    local class = "Unknown"
    pcall(function()
        class = instance.ClassName
    end)
    return class
end

local function safeFullName(instance)
    local ok, result = pcall(function()
        return instance:GetFullName()
    end)
    return ok and result or safeString(instance)
end

local function isLua(instance)
    local ok, result = pcall(function()
        return instance:IsA("LuaSourceContainer")
    end)
    if ok then
        return result
    end
    local class = safeClass(instance)
    return class == "LocalScript" or class == "ModuleScript" or class == "Script"
end

local function isRemote(instance)
    local class = safeClass(instance)
    return class == "RemoteEvent" or class == "RemoteFunction" or class == "UnreliableRemoteEvent"
end

local function isDescendant(instance, ancestor)
    if not instance or not ancestor then
        return false
    end
    local ok, result = pcall(function()
        return instance:IsDescendantOf(ancestor)
    end)
    return ok and result == true
end

