local function discoverByGlobalInstances()
    local scripts = {}
    local remotes = {}
    local seenScripts = {}
    local seenRemotes = {}
    local ok, instances = pcall(getinstancesFn)
    if not ok or type(instances) ~= "table" then
        return nil, nil
    end
    for i, instance in ipairs(instances) do
        if state.Cancelled then
            break
        end
        if isLuaContainer(instance) then
            local descriptor = descriptorFor(instance)
            if descriptor and not seenScripts[instance] then
                seenScripts[instance] = true
                scripts[#scripts + 1] = {Instance = instance, Root = descriptor}
            end
        elseif isRemote(instance) then
            local descriptor = descriptorFor(instance)
            if descriptor and not seenRemotes[instance] then
                seenRemotes[instance] = true
                remotes[#remotes + 1] = {Instance = instance, Root = descriptor}
            end
        end
        if i % 1500 == 0 then
            task.wait()
        end
    end
    return scripts, remotes
end

local function discoverScriptsFast()
    local scripts = {}
    local seen = {}
    local function addList(fn)
        if type(fn) ~= "function" then return false end
        local ok, list = pcall(fn)
        if not ok or type(list) ~= "table" then return false end
        for i, instance in ipairs(list) do
            if state.Cancelled then break end
            if isLuaContainer(instance) then
                local descriptor = descriptorFor(instance)
                if descriptor and not seen[instance] then seen[instance] = true; scripts[#scripts + 1] = {Instance = instance, Root = descriptor} end
            end
            if i % 1000 == 0 then task.wait() end
        end
        return true
    end
    local used = false
    if Capability.good("getscripts") then used = addList(getscriptsFn) or used end
    local running = global("getrunningscripts")
    if Capability.good("getrunningscripts") then used = addList(running) or used end
    return used and scripts or nil
end

local function discoverRootDescendants(scripts, remotes, seenScripts, seenRemotes)
    for _, descriptor in ipairs(rootDescriptors) do
        if descriptor.Selected and descriptor.Instance then
            local ok, descendants = pcall(function()
                return descriptor.Instance:GetDescendants()
            end)
            if ok then
                for i, instance in ipairs(descendants) do
                    if state.Cancelled then
                        return
                    end
                    local assigned = descriptorFor(instance)
                    if assigned == descriptor then
                        if isLuaContainer(instance) and not seenScripts[instance] then
                            seenScripts[instance] = true
                            scripts[#scripts + 1] = {Instance = instance, Root = descriptor}
                        elseif isRemote(instance) and not seenRemotes[instance] then
                            seenRemotes[instance] = true
                            remotes[#remotes + 1] = {Instance = instance, Root = descriptor}
                        end
                    end
                    if i % 800 == 0 then
                        task.wait()
                    end
                end
            else
                recordError("SCAN", descriptor.Key, descendants)
            end
        end
    end
end

local function scanStructure()
    if state.Running or state.Scanning then
        return
    end
    local selectedCount = 0
    for _, descriptor in ipairs(rootDescriptors) do
        if descriptor.Selected then
            selectedCount = selectedCount + 1
        end
    end
    if selectedCount == 0 then
        state.Message = "Select at least one root"
        state.Phase = "READY"
        updateUI()
        return
    end
    local scanStarted = os.clock()
    state.Scanning = true
    state.Cancelled = false
    state.Scanned = false
    state.Phase = "SCANNING"
    state.Message = "Indexing selected roots..."
    resolveRoots()
    rejected = {}
    updateUI()

    for _, descriptor in ipairs(rootDescriptors) do
        descriptor.ScriptCount = descriptor.Selected and 0 or nil
        descriptor.RemoteCount = descriptor.Selected and 0 or nil
    end

    local scripts = discoverScriptsFast() or {}
    local remotes = {}
    local seenScripts = {}
    local seenRemotes = {}
    for _, row in ipairs(scripts) do seenScripts[row.Instance] = true end
    discoverRootDescendants(scripts, remotes, seenScripts, seenRemotes)
    if state.Mode == "Deep" and Capability.good("getinstances") and not state.Cancelled then
        local globalScripts, globalRemotes = discoverByGlobalInstances()
        for _, row in ipairs(globalScripts or {}) do if not seenScripts[row.Instance] then seenScripts[row.Instance] = true; scripts[#scripts + 1] = row end end
        for _, row in ipairs(globalRemotes or {}) do if not seenRemotes[row.Instance] then seenRemotes[row.Instance] = true; remotes[#remotes + 1] = row end end
    end

    if not state.Cancelled then
        local priority = {ReplicatedStorage = 1, ReplicatedFirst = 2, StarterPlayer = 3, PlayerScripts = 4, StarterGui = 5, PlayerGui = 6, StarterPack = 7, Workspace = 8, Backpack = 9, Character = 10, Lighting = 11, SoundService = 12}
        table.sort(scripts, function(a, b)
            local pa = priority[a.Root.Key] or 50
            local pb = priority[b.Root.Key] or 50
            if pa ~= pb then return pa < pb end
            return safeFullName(a.Instance) < safeFullName(b.Instance)
        end)
        for _, row in ipairs(scripts) do
            row.Root.ScriptCount = (row.Root.ScriptCount or 0) + 1
        end
        for _, row in ipairs(remotes) do
            row.Root.RemoteCount = (row.Root.RemoteCount or 0) + 1
        end
        local scanRejected = {}
        for reason, count in pairs(rejected) do
            scanRejected[reason] = count
        end
        scanCache = {Scripts = scripts, Remotes = remotes, Counts = {}, Rejected = scanRejected}
        timings.Scan = os.clock() - scanStarted
        state.Scanned = true
        state.Phase = "READY"
        state.Message = tostring(#scripts) .. " code · " .. tostring(#remotes) .. " remotes ready"
    else
        state.Phase = "CANCELLED"
        state.Message = "Scan cancelled"
    end
    if state.Cancelled then
        timings.Scan = os.clock() - scanStarted
    end
    state.Scanning = false
    updateUI()
end

local function sourceFallback(instance)
    local ok, source = pcall(function()
        return instance.Source
    end)
    if ok and type(source) == "string" and source ~= "" then
        return source, "Source"
    end
end

local function decompileScript(instance)
    if decompileFn and Capability.good("decompile") then
        local ok, result = callWithTimeout(DECOMPILE_TIMEOUT, function()
            return decompileFn(instance)
        end)
        if ok and type(result) == "string" and result ~= "" then
            return result, "decompile"
        end
    end
    return sourceFallback(instance)
end

local function dumpBytecode(instance, descriptor)
    if not bytecodeFn or not options.BytecodeFailed or not Capability.good("getscriptbytecode") then
        return nil
    end
    local ok, data = pcall(bytecodeFn, instance)
    if not ok or type(data) ~= "string" or data == "" then
        return nil
    end
    local path = outputPathFor(instance, descriptor, "bytecode", ".bytecode")
    local okWrite, err = writeVerified(path, data, true)
    if not okWrite then
        recordError("BYTECODE", safeFullName(instance), err)
        return nil
    end
    return path
end

local function dumpOne(candidate)
    if state.Cancelled then
        return
    end
    local instance = candidate.Instance
    local descriptor = candidate.Root
    local fullName = safeFullName(instance)
    local started = os.clock()
    local source, method = decompileScript(instance)
    local row = {
        Name = safeString(instance.Name),
        Class = safeClass(instance),
        FullName = fullName,
        Root = descriptor.Key,
        Origin = descriptor.Group,
        Method = method or "none",
        Status = "FAILED",
        File = nil,
        Bytecode = nil,
        Size = 0,
        Hash = nil,
        ElapsedMs = 0
    }
    local getscripthash = global("getscripthash")
    if getscripthash and Capability.good("getscripthash") then
        local okHash, scriptHash = pcall(getscripthash, instance)
        if okHash and type(scriptHash) == "string" then row.Hash = scriptHash end
    end
    if source then
        local path = outputPathFor(instance, descriptor, "code", ".luau")
        local okWrite, err = writeVerified(path, source, false)
        if okWrite then
            row.Status = method == "decompile" and "DECOMPILED" or "SOURCE"
            row.File = path
            row.Size = #source
            state.Scripts = state.Scripts + 1
            acceptedScripts[instance] = candidate
            acceptedInstances[instance] = true
            if options.FullDump then
                fullDumpRows[#fullDumpRows + 1] = {
                    FullName = fullName,
                    Root = descriptor.Key,
                    Source = source
                }
            end
        else
            recordError("WRITE_CODE", fullName, err)
        end
    end
    if row.Status == "FAILED" then
        local bytecodePath = dumpBytecode(instance, descriptor)
        if bytecodePath then
            row.Status = "BYTECODE_ONLY"
            row.Bytecode = bytecodePath
            state.Scripts = state.Scripts + 1
            acceptedScripts[instance] = candidate
            acceptedInstances[instance] = true
        else
            recordError("DECOMPILE", fullName, "no readable source or bytecode")
        end
    end
    row.ElapsedMs = math.floor((os.clock() - started) * 1000)
    indexRows[#indexRows + 1] = row
end

local function workerCount(total)
    local override = tonumber(env.AnyDumper_Workers)
    if override then
        override = math.floor(override)
        if override >= 1 and override <= 12 then
            return math.min(override, math.max(1, total))
        end
    end
    local verifiedDecompiler = Capability.verified("decompile")
    local verifiedBytecode = Capability.verified("getscriptbytecode")
    local base = verifiedDecompiler and DEFAULT_WORKERS or (verifiedBytecode and 5 or 3)
    if total <= 24 then return math.min(verifiedDecompiler and 4 or 2, total) end
    if total >= 900 then return math.min(verifiedDecompiler and 10 or 6, total) end
    if total >= 400 then return math.min(verifiedDecompiler and 8 or 5, total) end
    return math.min(base, total)
end

local function dumpScripts()
    local started = os.clock()
    state.Phase = "DECOMPILING"
    state.Total = #scanCache.Scripts
    state.Processed = 0
    updateUI()
    if state.Total == 0 then
        return
    end
    local cursor = 0
    local completedWorkers = 0
    local workers = workerCount(state.Total)
    for _ = 1, workers do
        task.spawn(function()
            while not state.Cancelled do
                cursor = cursor + 1
                local index = cursor
                local candidate = scanCache.Scripts[index]
                if not candidate then
                    break
                end
                dumpOne(candidate)
                state.Processed = state.Processed + 1
                if state.Processed % 4 == 0 or state.Processed == state.Total then
                    updateUI()
                    task.wait()
                end
            end
            completedWorkers = completedWorkers + 1
        end)
    end
    while completedWorkers < workers do
        task.wait(0.05)
    end
    timings.Code = os.clock() - started
end

local function dumpRemotes()
    if not options.Remotes or state.Cancelled then
        return
    end
    local started = os.clock()
    state.Phase = "REMOTES"
    state.Total = #scanCache.Remotes
    state.Processed = 0
    updateUI()
    for i, candidate in ipairs(scanCache.Remotes) do
        if state.Cancelled then
            break
        end
        local instance = candidate.Instance
        local row = {
            Name = safeString(instance.Name),
            Class = safeClass(instance),
            FullName = safeFullName(instance),
            Root = candidate.Root.Key,
            Attributes = {},
            ClientConnections = nil,
            HasClientInvoke = nil
        }
        pcall(function()
            row.Attributes = instance:GetAttributes()
        end)
        local class = row.Class
        if class == "RemoteFunction" then
            pcall(function()
                row.HasClientInvoke = instance.OnClientInvoke ~= nil
            end)
        elseif getconnectionsFn then
            pcall(function()
                local connections = getconnectionsFn(instance.OnClientEvent)
                if type(connections) == "table" then
                    row.ClientConnections = #connections
                end
            end)
        end
        remoteRows[#remoteRows + 1] = row
        acceptedInstances[instance] = true
        state.Remotes = state.Remotes + 1
        state.Processed = i
        if i % 30 == 0 then
            updateUI()
            task.wait()
        end
    end
    timings.Remotes = os.clock() - started
end


function Network.capture(direction, packet)
    if not Network.Active then return end
    if #networkRows >= MAX_NETWORK_EVENTS then networkSummary.Dropped = networkSummary.Dropped + 1; return end
    local function field(namesList)
        for _, name in ipairs(namesList) do
            local ok, value = pcall(function() return packet[name] end)
            if ok and value ~= nil then return value end
        end
    end
    local data = field({"Data", "data", "Payload", "payload"})
    local size = field({"Size", "Length", "size", "length"})
    if size == nil then
        local kind = typeof and typeof(data) or type(data)
        if kind == "string" then size = #data
        elseif kind == "buffer" and type(buffer) == "table" and type(buffer.len) == "function" then pcall(function() size = buffer.len(data) end) end
    end
    networkRows[#networkRows + 1] = jsonSafe({Direction = direction, At = os.clock(), Id = field({"Id", "ID", "PacketId", "PacketID", "id"}), Priority = field({"Priority", "priority"}), Reliability = field({"Reliability", "reliability"}), OrderingChannel = field({"OrderingChannel", "orderingChannel", "Channel", "channel"}), Size = size, Kind = typeof and typeof(packet) or type(packet)})
    if direction == "receive" then networkSummary.Receive = networkSummary.Receive + 1 else networkSummary.Send = networkSummary.Send + 1 end
end

function Network.start()
    networkRows = {}
    networkSummary = {Receive = 0, Send = 0, Dropped = 0, StartedAt = os.clock(), StoppedAt = nil}
    Network.Active = false
    Network.Receive, Network.Send, Network.ReceiveConnection, Network.SendConnection = nil, nil, nil, nil
    if not options.NetworkTrace then return false end
    local raknet = global("raknet") or global("RakNet")
    if type(raknet) ~= "table" then return false end
    local started = false
    local addReceive = Capability.raknetFunction("add_receive_hook")
    if addReceive and Capability.good("raknet.add_receive_hook") then
        local callback = function(packet) Network.capture("receive", packet) end
        local ok, token = pcall(addReceive, callback)
        if ok then Network.Receive = token or callback; started = true else recordError("NETWORK", "add_receive_hook", token) end
    else
        local signal; pcall(function() signal = raknet.OnPacketReceive end)
        if signal then local ok, connection = pcall(function() return signal:Connect(function(packet) Network.capture("receive", packet) end) end); if ok then Network.ReceiveConnection = connection; started = true end end
    end
    local addSend = Capability.raknetFunction("add_send_hook")
    if addSend and Capability.good("raknet.add_send_hook") then
        local callback = function(packet) Network.capture("send", packet) end
        local ok, token = pcall(addSend, callback)
        if ok then Network.Send = token or callback; started = true else recordError("NETWORK", "add_send_hook", token) end
    else
        local signal; pcall(function() signal = raknet.OnPacketSend end)
        if signal then local ok, connection = pcall(function() return signal:Connect(function(packet) Network.capture("send", packet) end) end); if ok then Network.SendConnection = connection; started = true end end
    end
    Network.Active = started
    return started
end

function Network.stop()
    if not Network.Active then return end
    Network.Active = false
    local removeReceive = Capability.raknetFunction("remove_receive_hook")
    if removeReceive and Network.Receive then pcall(removeReceive, Network.Receive) end
    local removeSend = Capability.raknetFunction("remove_send_hook")
    if removeSend and Network.Send then pcall(removeSend, Network.Send) end
    if Network.ReceiveConnection then pcall(function() Network.ReceiveConnection:Disconnect() end) end
    if Network.SendConnection then pcall(function() Network.SendConnection:Disconnect() end) end
    networkSummary.StoppedAt = os.clock()
    if networkSummary.StartedAt then timings.Network = networkSummary.StoppedAt - networkSummary.StartedAt end
end

function Actor.collect()
    if not options.ActorScan or state.Cancelled or not Capability.good("getactors") then return end
    local getactors = global("getactors")
    if not getactors then return end
    local started = os.clock()
    state.Phase = "ACTORS"
    updateUI()
    local ok, actors = pcall(getactors)
    if not ok or type(actors) ~= "table" then recordError("ACTORS", "getactors", actors); return end
    local getactorthreads = global("getactorthreads")
    local getcurrentactor = global("getcurrentactor")
    for _, actor in ipairs(actors) do
        if state.Cancelled then break end
        local descriptor = descriptorFor(actor)
        if descriptor then
            local row = {Name = safeString(actor.Name), FullName = safeFullName(actor), Root = descriptor.Key, Threads = nil, Current = false}
            if getactorthreads and Capability.good("getactorthreads") then local okT, threads = pcall(getactorthreads, actor); if okT and type(threads) == "table" then row.Threads = #threads end end
            if getcurrentactor and Capability.good("getcurrentactor") then local okC, current = pcall(getcurrentactor); if okC then row.Current = current == actor end end
            actorRows[#actorRows + 1] = row
            state.Runtime = state.Runtime + 1
        else recordReject("ActorOutsideSelectedRoots") end
    end
    timings.Actors = os.clock() - started
end

local function functionInfo(fn)
    local row = {Name = nil, Source = nil, Arity = nil, Vararg = nil, Constants = nil, UpvalueCount = nil}
    if caps.debugInfo then
        pcall(function()
            row.Name = debug.info(fn, "n")
            row.Source = debug.info(fn, "s")
            local arity, vararg = debug.info(fn, "a")
            row.Arity = arity
            row.Vararg = vararg
        end)
    end
    if getconstantsFn then
        local ok, constants = pcall(getconstantsFn, fn)
        if ok and type(constants) == "table" then
            local keep = {}
            for _, value in ipairs(constants) do
                if type(value) == "string" then
                    local lower = string.lower(value)
                    if lower:find("remote", 1, true) or lower:find("invoke", 1, true) or lower:find("fire", 1, true) or lower:find("network", 1, true) or lower:find("packet", 1, true) or lower:find("replica", 1, true) then
                        keep[#keep + 1] = value
                        if #keep >= 20 then
                            break
                        end
                    end
                end
            end
            if #keep > 0 then
                row.Constants = keep
            end
        end
    end
    if getupvaluesFn then
        local ok, values = pcall(getupvaluesFn, fn)
        if ok and type(values) == "table" then
            local count = 0
            for _ in pairs(values) do
                count = count + 1
            end
            row.UpvalueCount = count
        end
    end
    return row
end

local function captureTable(tbl, link)
    if linkedTables[tbl] or #runtimeRows.Tables >= MAX_RUNTIME_TABLES then
        return
    end
    linkedTables[tbl] = link
    local keys = {}
    local count = 0
    local ok = pcall(function()
        for key in next, tbl do
            count = count + 1
            if #keys < MAX_RUNTIME_KEYS then
                keys[#keys + 1] = safeString(key)
            end
            if count >= 160 then
                break
            end
        end
    end)
    if ok then
        runtimeRows.Tables[#runtimeRows.Tables + 1] = {Link = link, Keys = keys}
        state.Runtime = state.Runtime + 1
    end
end

local function captureUpvalues(fn, owner)
    if not getupvaluesFn or not Capability.good("getupvalues") then
        return
    end
    local ok, values = pcall(getupvaluesFn, fn)
    if not ok or type(values) ~= "table" then
        return
    end
    for _, value in pairs(values) do
        local kind = typeof and typeof(value) or type(value)
        if kind == "table" then
            captureTable(value, "Upvalue:" .. owner)
        elseif kind == "function" and #runtimeRows.Functions < MAX_RUNTIME_FUNCTIONS and not isExecutorClosure(value) and not acceptedFunctions[value] then
            acceptedFunctions[value] = true
            local info = functionInfo(value)
            info.Owner = owner
            info.Ownership = "UpvalueFunction"
            runtimeRows.Functions[#runtimeRows.Functions + 1] = info
            state.Runtime = state.Runtime + 1
        elseif kind == "Instance" and safeParent(value) == nil then
            linkedNil[value] = "Upvalue:" .. owner
        end
    end
end

local function directRuntime()
    for instance, candidate in pairs(acceptedScripts) do
        if state.Cancelled then
            return
        end
        local owner = safeFullName(instance)
        if getsenvFn and Capability.good("getsenv") then
            local ok, scriptEnv = pcall(getsenvFn, instance)
            if ok and type(scriptEnv) == "table" then
                captureTable(scriptEnv, "Environment:" .. owner)
            end
        end
        local closure
        if getscriptclosureFn and Capability.good("getscriptclosure") then
            local ok, result = pcall(getscriptclosureFn, instance)
            if ok and type(result) == "function" then
                closure = result
            end
        end
        if not closure and getscriptfunctionFn and Capability.good("getscriptfunction") then
            local ok, result = pcall(getscriptfunctionFn, instance)
            if ok and type(result) == "function" then
                closure = result
            end
        end
        if closure and not acceptedFunctions[closure] then
            acceptedFunctions[closure] = true
            local info = functionInfo(closure)
            info.Owner = owner
            info.Root = candidate.Root.Key
            info.Ownership = "DirectScriptClosure"
            runtimeRows.Functions[#runtimeRows.Functions + 1] = info
            state.Runtime = state.Runtime + 1
            captureUpvalues(closure, owner)
        end
    end
end

local function moduleRuntime()
    if not getloadedmodulesFn or not Capability.good("getloadedmodules") then
        return
    end
    local ok, modules = pcall(getloadedmodulesFn)
    if not ok or type(modules) ~= "table" then
        recordError("RUNTIME", "getloadedmodules", modules)
        return
    end
    for _, module in ipairs(modules) do
        if state.Cancelled then
            return
        end
        local descriptor = descriptorFor(module)
        if descriptor then
            runtimeRows.Modules[#runtimeRows.Modules + 1] = {
                Name = safeString(module.Name),
                FullName = safeFullName(module),
                Root = descriptor.Key
            }
            acceptedInstances[module] = true
            state.Runtime = state.Runtime + 1
        end
    end
end

local acceptedSourceSet = {}

local function rebuildAcceptedSourceSet()
    acceptedSourceSet = {}
    for instance in pairs(acceptedScripts) do
        local full = string.lower(safeFullName(instance)):gsub("\\", "/"):gsub("/", ".")
        if full ~= "" then
            acceptedSourceSet[full] = true
            acceptedSourceSet["game." .. full] = true
        end
    end
end

local function sourceMatchesAccepted(source)
    local normalized = string.lower(safeString(source or "")):gsub("^[@=]", ""):gsub("\\", "/"):gsub("/", "."):gsub("%s+", "")
    return acceptedSourceSet[normalized] == true
end

local function envScriptFor(fn)
    if not getfenvFn or not Capability.good("getfenv") then
        return nil
    end
    local ok, functionEnv = pcall(getfenvFn, fn)
    if not ok or type(functionEnv) ~= "table" then
        return nil
    end
    local scriptValue
    pcall(function()
        scriptValue = rawget(functionEnv, "script") or functionEnv.script
    end)
    if (typeof and typeof(scriptValue) or type(scriptValue)) == "Instance" then
        return scriptValue
    end
end

local function deepRuntime()
    if state.Mode ~= "Deep" or not getgcFn or not Capability.good("getgc") or state.Cancelled then
        return
    end
    rebuildAcceptedSourceSet()
    local ok, objects = pcall(getgcFn, true)
    if not ok or type(objects) ~= "table" then
        recordError("RUNTIME", "getgc", objects)
        return
    end
    local limit = math.min(#objects, MAX_DEEP_RUNTIME_FUNCTIONS)
    state.Total = limit
    state.Processed = 0
    for i = 1, limit do
        if state.Cancelled then
            return
        end
        local object = objects[i]
        if type(object) == "function" and not acceptedFunctions[object] and not isExecutorClosure(object) then
            local linked = false
            local owner = ""
            local scriptValue = envScriptFor(object)
            if scriptValue and acceptedScripts[scriptValue] then
                linked = true
                owner = safeFullName(scriptValue)
            elseif caps.debugInfo then
                local source
                pcall(function()
                    source = debug.info(object, "s")
                end)
                if sourceMatchesAccepted(source) then
                    linked = true
                    owner = safeString(source)
                end
            end
            if linked then
                acceptedFunctions[object] = true
                local info = functionInfo(object)
                info.Owner = owner
                info.Ownership = "DeepLinked"
                runtimeRows.Functions[#runtimeRows.Functions + 1] = info
                state.Runtime = state.Runtime + 1
                captureUpvalues(object, owner)
            end
        end
        state.Processed = i
        if i % 1200 == 0 then
            updateUI()
            task.wait()
        end
    end
end

local function linkedNilRuntime()
    if not options.LinkedNil or state.Mode ~= "Deep" or not getnilinstancesFn or not Capability.good("getnilinstances") or state.Cancelled then
        return
    end
    local ok, instances = pcall(getnilinstancesFn)
    if not ok or type(instances) ~= "table" then
        recordError("RUNTIME", "getnilinstances", instances)
        return
    end
    for _, instance in ipairs(instances) do
        if state.Cancelled then
            return
        end
        if linkedNil[instance] then
            runtimeRows.NilInstances[#runtimeRows.NilInstances + 1] = {
                Name = safeString(instance.Name),
                Class = safeClass(instance),
                Link = linkedNil[instance]
            }
            state.Runtime = state.Runtime + 1
        end
    end
end

local function collectRuntime()
    if not options.Runtime or state.Mode == "Strict" or state.Cancelled then
        return
    end
    local started = os.clock()
    state.Phase = "RUNTIME"
    state.Total = math.max(1, #scanCache.Scripts)
    state.Processed = 0
    updateUI()
    moduleRuntime()
    directRuntime()
    if state.Mode == "Deep" then
        deepRuntime()
        linkedNilRuntime()
    end
    timings.Runtime = os.clock() - started
end

local function buildFilterReport()
    local lines = {
        "any dumper filter report",
        "credit: any ne",
        "mode: " .. state.Mode,
        "",
        "selected roots:"
    }
    for _, descriptor in ipairs(rootDescriptors) do
        if descriptor.Selected then
            lines[#lines + 1] = descriptor.Key .. ": " .. tostring(descriptor.ScriptCount or 0) .. " code, " .. tostring(descriptor.RemoteCount or 0) .. " remotes"
        end
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "capabilities:"
    lines[#lines + 1] = "verified: " .. tostring((capProfile.Summary and capProfile.Summary.Verified) or 0) .. "/" .. tostring((capProfile.Summary and capProfile.Summary.Total) or 0)
    lines[#lines + 1] = "actors: " .. tostring(#actorRows)
    lines[#lines + 1] = "network receive: " .. tostring(networkSummary.Receive or 0)
    lines[#lines + 1] = "network send: " .. tostring(networkSummary.Send or 0)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "rejected:"
    local keys = {}
    for reason in pairs(rejected) do
        keys[#keys + 1] = reason
    end
    table.sort(keys)
    if #keys == 0 then
        lines[#lines + 1] = "none"
    else
        for _, reason in ipairs(keys) do
            lines[#lines + 1] = reason .. ": " .. tostring(rejected[reason])
        end
    end
    return table.concat(lines, "\n")
end

local function buildErrorLog()
    if #errors == 0 then
