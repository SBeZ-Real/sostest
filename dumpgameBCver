            local ok, result = timed(math.min(6, DECOMPILE_TIMEOUT), function() return decompile(script) end)
            set("decompile", ok and type(result) == "string" and #result > 0 and "VERIFIED" or "FAILED", ok and (type(result) == "string" and tostring(#result) .. " chars" or type(result)) or result, "Decompiler")
        else set("decompile", "SKIPPED", "missing", "Decompiler") end
    else
        for _, name in ipairs(scriptTests) do
            set(name, type(global(name)) == "function" and "PRESENT" or "SKIPPED", "no probe script", name == "decompile" and "Decompiler" or "Scripts")
        end
    end

    local getactors = global("getactors")
    if getactors then
        local ok, actors = pcall(getactors)
        set("getactors", ok and type(actors) == "table" and "VERIFIED" or "FAILED", ok and (type(actors) == "table" and tostring(#actors) or type(actors)) or actors, "Actors")
        capProfile.Actors.Count = ok and type(actors) == "table" and #actors or 0
    else set("getactors", "SKIPPED", "missing", "Actors") end
    for _, name in ipairs({"getactorthreads", "getactorfromthread", "run_on_actor", "getcurrentactor", "getconnections", "setclipboard", "getstack", "setstack", "getproto", "getcallingscript", "getscriptfromthread"}) do
        present(name, (name:find("actor") or name == "run_on_actor") and "Actors" or (name:find("stack") or name == "getproto") and "Debug" or name == "getconnections" and "Signals" or "Scripts")
    end

    local raknet = global("raknet") or global("RakNet")
    local r = {Namespace = type(raknet) == "table", Enabled = nil, ReceiveHook = "SKIPPED", SendHook = "SKIPPED", OnPacketReceive = false, OnPacketSend = false, Mutation = false}
    if type(raknet) == "table" then
        set("raknet", "PRESENT", "namespace", "Network")
        local function rfn(name)
            local value
            pcall(function() value = raknet[name] end)
            return type(value) == "function" and value or nil
        end
        local enabled = rfn("is_enabled")
        if enabled then
            local ok, value = pcall(enabled)
            r.Enabled = ok and value == true or false
            set("raknet.is_enabled", ok and "VERIFIED" or "FAILED", ok and tostring(value) or value, "Network")
        else set("raknet.is_enabled", "SKIPPED", "missing", "Network") end
        for _, pair in ipairs({{"receive", "add_receive_hook", "remove_receive_hook"}, {"send", "add_send_hook", "remove_send_hook"}}) do
            local add, remove = rfn(pair[2]), rfn(pair[3])
            if add then
                local callback = function() end
                local ok, token = pcall(add, callback)
                local removed = false
                if ok and remove then
                    local okR = pcall(remove, token or callback)
                    if not okR then okR = pcall(remove, callback) end
                    removed = okR
                end
                local status = ok and (remove and removed and "VERIFIED" or "PRESENT") or "FAILED"
                set("raknet." .. pair[2], status, ok and (removed and "add/remove" or "add") or token, "Network")
                r[pair[1] == "receive" and "ReceiveHook" or "SendHook"] = status
            else set("raknet." .. pair[2], "SKIPPED", "missing", "Network") end
            set("raknet." .. pair[3], remove and "PRESENT" or "SKIPPED", nil, "Network")
        end
        pcall(function()
            r.OnPacketReceive = raknet.OnPacketReceive ~= nil
            r.OnPacketSend = raknet.OnPacketSend ~= nil
            r.Mutation = type(raknet.send) == "function"
        end)
        set("raknet.send", type(raknet.send) == "function" and "PRESENT" or "SKIPPED", "detected only", "Network")
    else
        set("raknet", "SKIPPED", "namespace missing", "Network")
    end
    capProfile.RakNet = r

    capProfile.Vulns = {Mode = "passive", Exposure = {
        HttpRequest = type(global("request") or global("http_request")) == "function",
        WebSocket = type(global("WebSocket") or global("websocket")) ~= "nil",
        FilesystemWrite = type(writefile) == "function",
        ClipboardWrite = type(global("setclipboard")) == "function",
        RakNetMutation = type(raknet) == "table" and type(raknet.send) == "function",
        DebugMutation = type(global("setstack")) == "function",
        ActorExecution = type(global("run_on_actor")) == "function"
    }}

    local categories = {
        Filesystem = {"writefile", "readfile", "appendfile", "makefolder", "isfolder", "isfile", "listfiles", "delfile", "delfolder"},
        Scripts = {"getscripts", "getrunningscripts", "getloadedmodules", "getscriptbytecode", "getscriptclosure", "getscriptfunction", "getsenv", "getscripthash"},
        Runtime = {"getgc", "getreg", "getinstances", "getnilinstances"},
        Debug = {"debug.info", "getconstants", "getupvalues", "getprotos", "getproto", "getstack", "setstack"},
        Closures = {"isexecutorclosure", "isourclosure", "islclosure", "iscclosure", "clonefunction"},
        Actors = {"getactors", "getactorthreads", "getactorfromthread", "run_on_actor", "getcurrentactor"},
        Network = {"raknet", "raknet.is_enabled", "raknet.add_receive_hook", "raknet.add_send_hook", "raknet.remove_receive_hook", "raknet.remove_send_hook", "raknet.send"},
        Decompiler = {"decompile", "getscriptbytecode"}
    }
    for category, members in pairs(categories) do
        local row = {Verified = 0, Present = 0, Failed = 0, Skipped = 0, Total = #members}
        for _, name in ipairs(members) do
            local value = capProfile.Functions[name]
            local status = value and value.Status or "SKIPPED"
            row[status == "VERIFIED" and "Verified" or status == "PRESENT" and "Present" or status == "FAILED" and "Failed" or "Skipped"] = row[status == "VERIFIED" and "Verified" or status == "PRESENT" and "Present" or status == "FAILED" and "Failed" or "Skipped"] + 1
        end
        capProfile.Categories[category] = row
    end

    local function standard(members, verifiedOnly)
        local passed = 0
        for _, name in ipairs(members) do
            local row = capProfile.Functions[name]
            if row and ((verifiedOnly and row.Status == "VERIFIED") or (not verifiedOnly and (row.Status == "VERIFIED" or row.Status == "PRESENT"))) then passed = passed + 1 end
        end
        return {Passed = passed, Total = #members}
    end
    capProfile.Standards = {
        UNC = standard({"writefile", "readfile", "makefolder", "isfile", "isfolder", "getscripts", "getloadedmodules", "getgc", "getnilinstances", "getconnections", "getsenv", "getfenv", "getscriptbytecode", "getscriptclosure", "getconstants", "getupvalues", "isexecutorclosure"}, false),
        SUNC = standard({"getscriptbytecode", "getscriptclosure", "getscripts", "getloadedmodules", "getgc", "getsenv", "isexecutorclosure", "iscclosure", "writefile", "readfile"}, true),
        Myriad = standard({"writefile", "readfile", "getgc", "getreg", "getscripts", "getloadedmodules", "getconstants", "getupvalues", "getprotos", "clonefunction", "getactors", "getconnections"}, true),
        debUNC = standard({"getgc", "getinstances", "getnilinstances", "getscriptbytecode", "getscriptclosure", "getconstants", "getprotos", "getstack", "getsenv", "getactors"}, false)
    }
    local summary = {Verified = 0, Present = 0, Failed = 0, Skipped = 0, Total = 0}
    for _, row in pairs(capProfile.Functions) do
        summary.Total = summary.Total + 1
        local key = row.Status == "VERIFIED" and "Verified" or row.Status == "PRESENT" and "Present" or row.Status == "FAILED" and "Failed" or "Skipped"
        summary[key] = summary[key] + 1
    end
    capProfile.Summary = summary
    timings.Capabilities = os.clock() - started
    capabilityBusy = false
    return capProfile
end

function Capability.ensure()
    if (capProfile.Summary and capProfile.Summary.Total or 0) == 0 and not capabilityBusy then Capability.run() end
    local deadline = os.clock() + 10
    while capabilityBusy and os.clock() < deadline do task.wait(0.05) end
    return (capProfile.Summary and capProfile.Summary.Total or 0) > 0
end

local function ensureFolder(path)
    if not makefolderFn then
        return false, "makefolder unavailable"
    end
    local current = ""
    for segment in path:gmatch("[^/]+") do
        current = current == "" and segment or current .. "/" .. segment
        local exists = false
        if isfolderFn then
            local ok, result = pcall(isfolderFn, current)
            exists = ok and result == true
        end
        if not exists then
            local ok, err = pcall(makefolderFn, current)
            if not ok and isfolderFn then
                local ok2, result2 = pcall(isfolderFn, current)
                if not ok2 or not result2 then
                    return false, safeString(err)
                end
            end
        end
    end
    return true
end

local function parentPath(path)
    return path:match("^(.*)/[^/]+$")
end

local function uniquePath(path)
    if not usedPaths[path] then
        usedPaths[path] = true
        return path
    end
    local base, ext = path:match("^(.*)(%.[^%./]+)$")
    base = base or path
    ext = ext or ""
    local i = 2
    local candidate = base .. "_" .. tostring(i) .. ext
    while usedPaths[candidate] do
        i = i + 1
        candidate = base .. "_" .. tostring(i) .. ext
    end
    usedPaths[candidate] = true
    return candidate
end

local function writeVerified(path, data, binary)
    if not writefileFn then
        return false, "writefile unavailable"
    end
    local parent = parentPath(path)
    if parent then
        local okFolder, folderErr = ensureFolder(parent)
        if not okFolder then
            return false, folderErr
        end
    end
    local ok, err = pcall(writefileFn, path, data)
    if not ok then
        return false, safeString(err)
    end
    if not binary and readfileFn then
        local okRead, readBack = pcall(readfileFn, path)
        if not okRead then
            return false, "readback failed: " .. safeString(readBack)
        end
        if readBack ~= data then
            return false, "readback content mismatch"
        end
    elseif isfileFn then
        local okFile, exists = pcall(isfileFn, path)
        if not okFile or not exists then
            return false, "file missing after write"
        end
    end
    return true
end

local function timestamp()
    local ok, value = pcall(function()
