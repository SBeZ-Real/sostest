end

local function relativeSegments(instance, descriptor)
    local parts = {}
    local cursor = instance
    local guard = 0
    while cursor and cursor ~= descriptor.Instance and guard < 100 do
        table.insert(parts, 1, sanitize(cursor.Name))
        cursor = safeParent(cursor)
        guard = guard + 1
    end
    if #parts == 0 then
        parts[1] = sanitize(instance.Name)
    end
    return parts
end

local function outputPathFor(instance, descriptor, kind, extension)
    local parts = {state.RunRoot, kind, sanitize(descriptor.Output)}
    for _, segment in ipairs(relativeSegments(instance, descriptor)) do
        parts[#parts + 1] = segment
    end
    return uniquePath(table.concat(parts, "/") .. extension)
end

local function isExecutorClosure(fn)
    if isexecutorclosureFn then
        local ok, result = pcall(isexecutorclosureFn, fn)
        if ok and result == true then
            return true
        end
    end
    if isourclosureFn then
        local ok, result = pcall(isourclosureFn, fn)
        if ok and result == true then
            return true
        end
    end
    return false
end

local function callWithTimeout(seconds, fn)
    local done = false
    local okResult
    local result
    local thread = task.spawn(function()
        okResult, result = pcall(fn)
        done = true
    end)
    local started = os.clock()
    while not done and not state.Cancelled do
        if os.clock() - started >= seconds then
            pcall(function()
                task.cancel(thread)
            end)
            return false, "timeout"
        end
        task.wait(0.03)
    end
    if state.Cancelled then
        pcall(function()
            task.cancel(thread)
        end)
        return false, "cancelled"
    end
    return okResult, result
end

