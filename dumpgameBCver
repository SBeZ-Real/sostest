function __CBX.getInstanceMetadata(inst)
    local metadata = {
        Name = tostring(inst.Name),
        Class = getClassName(inst),
        Path = __CBX.safeFullName(inst),
        Parent = inst.Parent and __CBX.safeFullName(inst.Parent) or nil,
