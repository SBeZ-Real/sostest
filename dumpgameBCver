            unMsg.TextXAlignment = Enum.TextXAlignment.Left
            unMsg.Parent = detectionsPanel
            detectionsPanel.CanvasSize = UDim2.new(0, 0, 0, 60)
        elseif threat.Level == "ANALYSIS_FAILED" then
            local failMsg = Instance.new("TextLabel")
