local function topInside(instance, root)
    local cursor = instance
    local previous = instance
    local guard = 0
    while cursor and cursor ~= root and guard < 100 do
        previous = cursor
        cursor = safeParent(cursor)
        guard = guard + 1
    end
    if cursor == root then
        return previous
    end
end

local function isKnownRobloxDefault(instance, descriptor)
    if descriptor.Group ~= "Local Player" and descriptor.Key ~= "StarterPlayer" and descriptor.Key ~= "StarterGui" then
        return false
    end
    local cursor = instance
    local guard = 0
    while cursor and cursor ~= descriptor.Instance and guard < 100 do
        if blockedPlayerRoots[safeString(cursor.Name)] then
            return true
        end
        cursor = safeParent(cursor)
        guard = guard + 1
    end
    return false
end

local function instanceAllowed(instance, descriptor)
    if not instance or not descriptor or not descriptor.Instance then
        return false, "InvalidRoot"
    end
    if safeClass(instance) == "CoreScript" then
        return false, "CoreScript"
    end
    if instance ~= descriptor.Instance and not descendant(instance, descriptor.Instance) then
        return false, "OutsideSelectedRoot"
    end
    if descendant(instance, CoreGui) then
        return false, "CoreGui"
    end
    if descriptor.Key == "Workspace" then
        local other, localCharacter = otherPlayerCharacter(instance)
        if other then
            return false, "OtherPlayerCharacter"
        end
        if localCharacter then
            return false, "LocalCharacterSeparateRoot"
        end
    end
    if isKnownRobloxDefault(instance, descriptor) then
        return false, "RobloxDefaultPlayer"
    end
    return true, "SelectedRoot"
end

