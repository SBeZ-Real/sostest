function __CBX.getFunctionProtos(fn)
    local protos = {}
    if __CBX.getProtosFunc then
        pcall(function()
            local result = __CBX.getProtosFunc(fn)
            if type(result) == "table" then protos = result end
        end)
    elseif __CBX.getProtoFunc then
        for i = 1, 128 do
            local ok, proto = pcall(function() return __CBX.getProtoFunc(fn, i, true) end)
            if not ok then
                ok, proto = pcall(function() return __CBX.getProtoFunc(fn, i) end)
            end
            if not ok or proto == nil then break end
            if type(proto) == "table" then
                for _, item in ipairs(proto) do
                    if type(item) == "function" then table.insert(protos, item) end
                end
            elseif type(proto) == "function" then
                table.insert(protos, proto)
            end
        end
    end
    return protos
end
local function inspectFunction(fn, depth, visited)
    depth = depth or 0
    visited = visited or {}
    local pad = string.rep("    ", depth)
    local inner = string.rep("    ", depth + 1)
    if depth > 6 then return "function(...) end" end
    if type(fn) ~= "function" or visited[fn] then return "function(...) end" end
    visited[fn] = true
    local info = __CBX.getFunctionInfo(fn)
    local params = {}
    local numParams = tonumber(info.numparams) or 0
    for i = 1, numParams do params[i] = "arg" .. i end
    if info.is_vararg == true or info.is_vararg == 1 then table.insert(params, "...") end
    local lines = { string.format("%sfunction(%s)", pad, table.concat(params, ", ")) }
    table.insert(lines, inner .. "local FUNCTION_INFO = " .. __CBX.serializeValue({
        name = info.name,
        source = info.source or info.short_src,
        currentline = info.currentline,
        linedefined = info.linedefined,
        lastlinedefined = info.lastlinedefined,
        numparams = info.numparams,
        is_vararg = info.is_vararg,
        what = info.what
    }, 0, {}, 32))
    local constants = {}
    if getConsts then pcall(function() constants = getConsts(fn) or {} end) end
    local hasConstants = false
    for _ in pairs(constants) do hasConstants = true break end
    if hasConstants then
        table.insert(lines, inner .. "local CONSTANTS = {")
        local keys = {}
        for k in pairs(constants) do table.insert(keys, k) end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        for _, k in ipairs(keys) do
            table.insert(lines, string.format("%s    [%s] = %s,", inner, __CBX.serializeValue(k), __CBX.serializeValue(constants[k], 0, {}, 80)))
        end
        table.insert(lines, inner .. "}")
    end
    local upvalues = {}
    if getUpvals then pcall(function() upvalues = getUpvals(fn) or {} end) end
    local hasUpvalues = false
    for _ in pairs(upvalues) do hasUpvalues = true break end
    if hasUpvalues then
        table.insert(lines, inner .. "local UPVALUES = {")
        local keys = {}
        for k in pairs(upvalues) do table.insert(keys, k) end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        for _, k in ipairs(keys) do
            local value = upvalues[k]
            local formatted = type(value) == "function" and inspectFunction(value, depth + 2, visited) or __CBX.serializeValue(value, 0, {}, 80)
            table.insert(lines, string.format("%s    [%s] = %s,", inner, __CBX.serializeValue(k), formatted))
        end
        table.insert(lines, inner .. "}")
    end
    local protos = __CBX.getFunctionProtos(fn)
    if #protos > 0 then
        table.insert(lines, inner .. "local PROTOS = {")
        for index, proto in ipairs(protos) do
            if type(proto) == "function" then
                table.insert(lines, string.format("%s    [%d] = %s,", inner, index, inspectFunction(proto, depth + 2, visited)))
            end
        end
        table.insert(lines, inner .. "}")
    end
    table.insert(lines, pad .. "end")
    visited[fn] = nil
    return table.concat(lines, "\n")
end

function __CBX.bytesToHex(value)
    return (value:gsub(".", function(c) return string.format("%02x", string.byte(c)) end))
end

local function resolveSource(inst)
    local artifacts = {
        Attempts = {},
        Bytecode = nil,
        BytecodeLength = 0,
        BytecodeHash = nil,
        ClosureAvailable = false
    }
    local bestCode = nil
    local bestMethod = nil
    local resolvedClosure = nil
    if decompileFunc then
        local ok, result = pcall(function() return decompileFunc(inst) end)
        artifacts.Attempts.DECOMPILE = ok and type(result) == "string" and #result or 0
        if ok and isDecompileValid(result) then
            bestCode = result
            bestMethod = "DECOMPILED"
        end
    end
    if not bestCode then
        local source = ""
        local sourceOk = pcall(function() source = inst.Source end)
        artifacts.Attempts.SOURCE = sourceOk and type(source) == "string" and #source or 0
        if sourceOk and isDecompileValid(source) then
            bestCode = source
            bestMethod = "SOURCE"
        end
    end
    if getScriptClosureFunc then
        local closureOk, closure = pcall(function() return getScriptClosureFunc(inst) end)
        if closureOk and type(closure) == "function" then
            resolvedClosure = closure
            artifacts.ClosureAvailable = true
            artifacts.ClosureInfo = __CBX.normalizeValue(__CBX.getFunctionInfo(closure))
            if not bestCode then
                local reconstructed = inspectFunction(closure, 0, {})
                if type(reconstructed) == "string" and #reconstructed > 0 then
                    bestCode = "local RECONSTRUCTED_CLOSURE = " .. reconstructed .. "\nreturn RECONSTRUCTED_CLOSURE"
                    bestMethod = "RECONSTRUCTED_CLOSURE"
                end
            end
        end
    end
    local bytecode = nil
    if getBytecodeFunc then
        pcall(function() bytecode = getBytecodeFunc(inst) end)
    elseif __CBX.dumpStringFunc and resolvedClosure then
        pcall(function() bytecode = __CBX.dumpStringFunc(resolvedClosure) end)
    end
    if type(bytecode) == "string" and #bytecode > 0 then
        artifacts.Bytecode = bytecode
        artifacts.BytecodeLength = #bytecode
        artifacts.BytecodeHash = computeHash(bytecode)
        if not bestCode then
            bestCode = string.format("local raw_bytecode_length = %d\nlocal raw_bytecode_hash = %s\nlocal raw_bytecode_hex = %s\nreturn raw_bytecode_hex", #bytecode, quoteString(artifacts.BytecodeHash), quoteString(__CBX.bytesToHex(bytecode)))
            bestMethod = "RAW_BYTECODE"
        end
    end
    __CBX.ScriptArtifacts[inst] = artifacts
    if bestCode then return bestCode, bestMethod end
    return "return nil", "FAILED"
end

