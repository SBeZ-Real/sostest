local function discoverSelectedScripts()
    local scripts = {}
    local seen = {}
    for _, selected in ipairs(selectedRoots()) do
        local entry = selected.Entry
        local root = selected.Root
        local items = {root}
        local ok, descendants = pcall(function()
            return root:GetDescendants()
        end)
        if ok and type(descendants) == "table" then
            for _, child in ipairs(descendants) do
                items[#items + 1] = child
            end
        end
        for index, instance in ipairs(items) do
            if state.Cancelled then
                return scripts
            end
            if isLua(instance) and not seen[instance] then
                filterStats.ScriptsDiscovered = filterStats.ScriptsDiscovered + 1
                local allowed, reason = instanceAllowed(instance, entry, root)
                if allowed then
                    seen[instance] = true
                    scripts[#scripts + 1] = {Instance = instance, Entry = entry, Root = root, Reason = reason}
                    acceptedScripts[instance] = true
                    acceptedInstances[instance] = true
                    filterStats.ScriptsAccepted = filterStats.ScriptsAccepted + 1
                else
                    reject(reason)
                end
            end
            if index % 700 == 0 then
                updateUI()
                task.wait()
            end
        end
    end
    return scripts
end

local function readScriptSource(instance)
    local source
    local method
    local decompileError
    if decompileFn then
        local ok, result = pcall(decompileFn, instance)
        if ok and type(result) == "string" and result ~= "" then
            source = result
            method = "decompile"
        else
            decompileError = result
        end
    end
    if not source then
        local ok, result = pcall(function()
            return instance.Source
        end)
        if ok and type(result) == "string" and result ~= "" then
            source = result
            method = "Source"
        end
    end
    return source, method, decompileError
end

local function dumpScript(item)
    local instance = item.Instance
    local fullName = safeFullName(instance)
    local source, method, decompileError = readScriptSource(instance)
    local row = {
        Name = safeString(instance.Name),
        Class = safeClass(instance),
        FullName = fullName,
        SelectedRoot = item.Entry.Id,
        Origin = item.Entry.Group,
        ReasonAccepted = item.Reason,
        Method = method or "none",
        File = nil,
        Bytecode = nil,
        Status = "FAILED"
    }
    if source then
        local path = outputPath("code", item.Entry, item.Root, instance, ".luau")
        local ok, err = writeVerified(path, source)
        if ok then
            row.File = path
            row.Status = "OK"
            state.Code = state.Code + 1
            if options.FullDump then
                fullDumpEntries[#fullDumpEntries + 1] = {
                    Path = fullName,
                    Root = item.Entry.Id,
                    Class = safeClass(instance),
                    Source = source
                }
            end
        else
            recordError("WRITE_CODE", fullName, err)
        end
    end
    if options.Bytecode and bytecodeFn then
        local okByte, bytecode = pcall(bytecodeFn, instance)
        if okByte and type(bytecode) == "string" and bytecode ~= "" then
            local path = outputPath("bytecode", item.Entry, item.Root, instance, ".bytecode")
            local okWrite, errWrite = writeVerified(path, bytecode)
            if okWrite then
                row.Bytecode = path
                if row.Status ~= "OK" then
                    row.Status = "BYTECODE_ONLY"
                    state.Code = state.Code + 1
                end
            else
                recordError("WRITE_BYTECODE", fullName, errWrite)
            end
        end
    end
    if row.Status == "FAILED" then
        recordError("DECOMPILE", fullName, decompileError or "no readable source")
    end
    codeIndex[#codeIndex + 1] = row
end

local function collectSelectedRemotes()
    if not options.Remotes then
        return
    end
    local seen = {}
    for _, selected in ipairs(selectedRoots()) do
        local entry = selected.Entry
        local root = selected.Root
        local items = {root}
        local ok, descendants = pcall(function()
            return root:GetDescendants()
        end)
        if ok and type(descendants) == "table" then
            for _, child in ipairs(descendants) do
                items[#items + 1] = child
            end
        end
        for index, instance in ipairs(items) do
            if state.Cancelled then
                return
            end
            if isRemote(instance) and not seen[instance] then
                filterStats.RemotesDiscovered = filterStats.RemotesDiscovered + 1
                local allowed, reason = instanceAllowed(instance, entry, root)
                if allowed then
                    seen[instance] = true
                    acceptedInstances[instance] = true
                    local row = {
                        Name = safeString(instance.Name),
                        Class = safeClass(instance),
                        FullName = safeFullName(instance),
                        SelectedRoot = entry.Id,
                        ReasonAccepted = reason,
                        Attributes = {},
                        ClientConnections = nil,
                        HasClientInvoke = nil
                    }
                    pcall(function()
                        row.Attributes = jsonSafe(instance:GetAttributes()) or {}
                    end)
                    if getconnectionsFn and safeClass(instance) ~= "RemoteFunction" then
                        local okConnections, connections = pcall(function()
                            return getconnectionsFn(instance.OnClientEvent)
                        end)
                        if okConnections and type(connections) == "table" then
                            row.ClientConnections = #connections
                        end
                    elseif safeClass(instance) == "RemoteFunction" then
                        pcall(function()
                            row.HasClientInvoke = instance.OnClientInvoke ~= nil
                        end)
                    end
                    remoteIndex[#remoteIndex + 1] = row
                    state.Remotes = state.Remotes + 1
                    filterStats.RemotesAccepted = filterStats.RemotesAccepted + 1
                else
                    reject(reason)
                end
            end
            if index % 700 == 0 then
                updateUI()
                task.wait()
            end
        end
    end
end

local function buildAcceptedSourceSet()
    local set = {}
    for instance in pairs(acceptedScripts) do
        local full = normalizeSource(safeFullName(instance))
        if full ~= "" then
            set[full] = true
            set["game." .. full] = true
        end
    end
    return set
end

local function sourceLinked(source, set)
    local rejected, rejectReason = sourceRejected(source)
    if rejected then
        return false, rejectReason
    end
    local normalized = normalizeSource(source)
    if normalized == "" then
        return false, "NoSource"
    end
    if set[normalized] then
        return true, "AcceptedSource"
    end
    for token in pairs(set) do
        if #token >= 8 and normalized:find(token, 1, true) then
            return true, "AcceptedSourcePath"
        end
    end
    if state.Mode == "Deep" then
        local prefixes = {
            "replicatedstorage.",
            "replicatedfirst.",
            "workspace.",
            "starterplayer.",
            "startergui.",
            "starterpack.",
            "lighting.",
            "soundservice."
        }
        for _, prefix in ipairs(prefixes) do
            if normalized:find(prefix, 1, true) == 1 then
                return true, "DeepSource"
            end
        end
    end
    return false, "UnlinkedSource"
end

local function functionInfo(fn)
    local row = {Name = nil, Source = nil, Arity = nil, Vararg = nil, Constants = nil, UpvalueCount = nil, Owner = nil, Ownership = nil}
    if caps.debugInfo then
        pcall(function()
            row.Name = debug.info(fn, "n")
        end)
        pcall(function()
            row.Source = debug.info(fn, "s")
        end)
        pcall(function()
            local arity, vararg = debug.info(fn, "a")
            row.Arity = arity
            row.Vararg = vararg
        end)
    end
    if getconstantsFn then
        local ok, constants = pcall(getconstantsFn, fn)
        if ok and type(constants) == "table" then
            local interesting = {}
            for _, value in ipairs(constants) do
                if type(value) == "string" then
                    local lower = string.lower(value)
                    if lower:find("remote", 1, true) or lower:find("invoke", 1, true) or lower:find("fire", 1, true) or lower:find("network", 1, true) or lower:find("replica", 1, true) or lower:find("packet", 1, true) then
                        interesting[#interesting + 1] = value
                        if #interesting >= 20 then
                            break
                        end
                    end
                end
            end
            if #interesting > 0 then
                row.Constants = interesting
            end
        end
    end
    if getupvaluesFn then
        local ok, values = pcall(getupvaluesFn, fn)
        if ok and type(values) == "table" then
            local count = 0
            for _ in pairs(values) do
                count = count + 1
            end
            row.UpvalueCount = count
        end
    end
    return row
end

local function envScript(fn)
    if not getfenvFn then
        return nil
    end
    local ok, environment = pcall(getfenvFn, fn)
    if not ok or type(environment) ~= "table" then
        return nil
    end
    local scriptValue
    pcall(function()
        scriptValue = rawget(environment, "script") or environment.script
    end)
    if (typeof and typeof(scriptValue) or type(scriptValue)) == "Instance" then
        return scriptValue
    end
end

local function functionOwnership(fn, info, sourceSet)
    if isExecutorClosure(fn) then
        return false, "ExecutorClosure", nil
    end
    local scriptValue = envScript(fn)
    if scriptValue then
        if acceptedScripts[scriptValue] then
            return true, "EnvScript", safeFullName(scriptValue)
        end
        local entry, root = rootForInstance(scriptValue)
        if entry and entry.Selected and root then
            local allowed, reason = instanceAllowed(scriptValue, entry, root)
            if allowed and isLua(scriptValue) then
                return true, "EnvScript:" .. reason, safeFullName(scriptValue)
            end
        end
        return false, "ForeignEnvScript", safeFullName(scriptValue)
    end
    local linked, reason = sourceLinked(info.Source, sourceSet)
    if linked then
        return true, reason, safeString(info.Source)
    end
    return false, reason, safeString(info.Source)
end

local function linkUpvalues(fn)
    if not getupvaluesFn then
        return
    end
    local ok, values = pcall(getupvaluesFn, fn)
    if not ok or type(values) ~= "table" then
        return
    end
    for _, value in pairs(values) do
        local kind = typeof and typeof(value) or type(value)
        if kind == "table" then
            linkedTables[value] = linkedTables[value] or "AcceptedFunctionUpvalue"
        elseif kind == "Instance" and not safeParent(value) then
            linkedNilInstances[value] = linkedNilInstances[value] or "AcceptedFunctionUpvalue"
        end
    end
end

local function tableKeys(tbl)
    local keys = {}
    local count = 0
    pcall(function()
        for key in next, tbl do
            count = count + 1
            if #keys < 40 then
                keys[#keys + 1] = safeString(key)
            end
            if count >= 100 then
                break
            end
        end
    end)
    return keys
end

local function tableLinked(tbl)
    if linkedTables[tbl] then
        return true, linkedTables[tbl]
    end
    local reason
    local scanned = 0
    pcall(function()
        for key, value in next, tbl do
            scanned = scanned + 1
            for _, candidate in ipairs({key, value}) do
                local kind = typeof and typeof(candidate) or type(candidate)
                if kind == "Instance" and acceptedInstances[candidate] then
                    reason = "AcceptedInstance"
                    break
                end
                if kind == "function" and acceptedFunctions[candidate] then
                    reason = "AcceptedFunction"
                    break
                end
                if kind == "table" and linkedTables[candidate] then
                    reason = "LinkedTable"
                    break
                end
            end
            if reason or scanned >= 80 then
                break
            end
        end
    end)
    return reason ~= nil, reason or "UnlinkedTable"
end

local function collectRuntime()
    if not options.RuntimeLinked or state.Mode == "Strict" then
        return
    end

    local selectedSet = {}
    for instance in pairs(acceptedScripts) do
        selectedSet[instance] = true
    end

    if getloadedmodulesFn then
        local ok, modules = pcall(getloadedmodulesFn)
        if ok and type(modules) == "table" then
            for _, module in ipairs(modules) do
                if state.Cancelled then
                    return
                end
                filterStats.ModulesDiscovered = filterStats.ModulesDiscovered + 1
                local entry, root = rootForInstance(module)
                if entry and entry.Selected and root then
                    local allowed, reason = instanceAllowed(module, entry, root)
                    if allowed then
                        runtimeIndex.Modules[#runtimeIndex.Modules + 1] = {
                            Name = safeString(module.Name),
                            FullName = safeFullName(module),
                            SelectedRoot = entry.Id,
                            ReasonAccepted = reason
                        }
                        acceptedInstances[module] = true
                        filterStats.ModulesAccepted = filterStats.ModulesAccepted + 1
                        state.Runtime = state.Runtime + 1
                    else
                        reject(reason)
                    end
                else
                    reject("ModuleOutsideSelection")
                end
            end
        else
            recordError("RUNTIME", "getloadedmodules", modules)
        end
    end

    for scriptInstance in pairs(selectedSet) do
        if state.Cancelled then
            return
        end
        if getsenvFn then
            local ok, environment = pcall(getsenvFn, scriptInstance)
            if ok and type(environment) == "table" then
                linkedTables[environment] = linkedTables[environment] or "ScriptEnvironment"
            end
        end
        local closure
        if getscriptclosureFn then
            local ok, result = pcall(getscriptclosureFn, scriptInstance)
            if ok and type(result) == "function" then
                closure = result
            end
        end
        if not closure and getscriptfunctionFn then
            local ok, result = pcall(getscriptfunctionFn, scriptInstance)
            if ok and type(result) == "function" then
                closure = result
            end
        end
        if closure and not acceptedFunctions[closure] and not isExecutorClosure(closure) then
            local info = functionInfo(closure)
            info.Owner = safeFullName(scriptInstance)
            info.Ownership = "DirectScriptClosure"
            runtimeIndex.Functions[#runtimeIndex.Functions + 1] = info
            acceptedFunctions[closure] = true
            filterStats.RuntimeFunctionsAccepted = filterStats.RuntimeFunctionsAccepted + 1
            state.Runtime = state.Runtime + 1
            linkUpvalues(closure)
        end
    end

    if getgcFn then
        local sourceSet = buildAcceptedSourceSet()
        local ok, objects = pcall(getgcFn, true)
        if ok and type(objects) == "table" then
            local functionScanLimit = state.Mode == "Deep" and 24000 or 12000
            local tableScanLimit = state.Mode == "Deep" and 28000 or 14000
            local functionAcceptedLimit = state.Mode == "Deep" and 5000 or 2500
            local tableAcceptedLimit = state.Mode == "Deep" and 2400 or 1000
            local functionScanned = 0
            local functionAccepted = 0
            for index, object in ipairs(objects) do
                if state.Cancelled then
                    return
                end
                if type(object) == "function" and not acceptedFunctions[object] and functionScanned < functionScanLimit and functionAccepted < functionAcceptedLimit then
                    functionScanned = functionScanned + 1
                    filterStats.RuntimeFunctionsScanned = filterStats.RuntimeFunctionsScanned + 1
                    local info = functionInfo(object)
                    local owned, ownership, owner = functionOwnership(object, info, sourceSet)
                    if owned then
                        info.Owner = owner
                        info.Ownership = ownership
                        runtimeIndex.Functions[#runtimeIndex.Functions + 1] = info
                        acceptedFunctions[object] = true
                        filterStats.RuntimeFunctionsAccepted = filterStats.RuntimeFunctionsAccepted + 1
                        functionAccepted = functionAccepted + 1
                        state.Runtime = state.Runtime + 1
                        linkUpvalues(object)
                    else
                        reject(ownership)
                    end
                end
                if index % 1300 == 0 then
                    updateUI()
                    task.wait()
                end
            end

            local tableScanned = 0
            local tableAccepted = 0
            for index, object in ipairs(objects) do
                if state.Cancelled then
                    return
                end
                if type(object) == "table" and tableScanned < tableScanLimit and tableAccepted < tableAcceptedLimit then
                    tableScanned = tableScanned + 1
                    filterStats.RuntimeTablesScanned = filterStats.RuntimeTablesScanned + 1
                    local linked, reason = tableLinked(object)
                    if linked then
                        runtimeIndex.Tables[#runtimeIndex.Tables + 1] = {Keys = tableKeys(object), Link = reason}
                        linkedTables[object] = linkedTables[object] or reason
                        filterStats.RuntimeTablesAccepted = filterStats.RuntimeTablesAccepted + 1
                        tableAccepted = tableAccepted + 1
                        state.Runtime = state.Runtime + 1
                    else
                        reject(reason)
                    end
                end
                if index % 1300 == 0 then
                    updateUI()
                    task.wait()
                end
            end
        else
            recordError("RUNTIME", "getgc", objects)
        end
    end

    if options.LinkedNil and getnilinstancesFn then
        local ok, nils = pcall(getnilinstancesFn)
        if ok and type(nils) == "table" then
            for _, instance in ipairs(nils) do
                if state.Cancelled then
                    return
                end
                if isLua(instance) or isRemote(instance) then
                    filterStats.NilDiscovered = filterStats.NilDiscovered + 1
                    if linkedNilInstances[instance] then
                        runtimeIndex.NilInstances[#runtimeIndex.NilInstances + 1] = {
                            Name = safeString(instance.Name),
                            Class = safeClass(instance),
                            Link = linkedNilInstances[instance]
                        }
                        filterStats.NilAccepted = filterStats.NilAccepted + 1
                        state.Runtime = state.Runtime + 1
                    else
                        reject("NilUnlinked")
                    end
                end
            end
        else
            recordError("RUNTIME", "getnilinstances", nils)
        end
    end
end

local function buildFilterReport()
    local lines = {
        "any dumper filter report",
        "credit: any ne",
        "mode: " .. state.Mode,
        "",
        "scripts discovered: " .. tostring(filterStats.ScriptsDiscovered),
        "scripts accepted: " .. tostring(filterStats.ScriptsAccepted),
        "remotes discovered: " .. tostring(filterStats.RemotesDiscovered),
        "remotes accepted: " .. tostring(filterStats.RemotesAccepted),
        "modules discovered: " .. tostring(filterStats.ModulesDiscovered),
        "modules accepted: " .. tostring(filterStats.ModulesAccepted),
        "runtime functions scanned: " .. tostring(filterStats.RuntimeFunctionsScanned),
        "runtime functions accepted: " .. tostring(filterStats.RuntimeFunctionsAccepted),
        "runtime tables scanned: " .. tostring(filterStats.RuntimeTablesScanned),
        "runtime tables accepted: " .. tostring(filterStats.RuntimeTablesAccepted),
        "nil discovered: " .. tostring(filterStats.NilDiscovered),
        "nil accepted: " .. tostring(filterStats.NilAccepted),
        "",
        "rejected:"
    }
    local keys = {}
    for reason in pairs(filterStats.Rejected) do
        keys[#keys + 1] = reason
    end
    table.sort(keys)
    if #keys == 0 then
        lines[#lines + 1] = "none"
    else
        for _, reason in ipairs(keys) do
            lines[#lines + 1] = reason .. ": " .. tostring(filterStats.Rejected[reason])
        end
    end
    return table.concat(lines, "\n")
end

local function buildErrorLog()
    if #errors == 0 then
        return "No errors recorded."
    end
    local lines = {}
    for index, row in ipairs(errors) do
        lines[#lines + 1] = "[" .. tostring(index) .. "] " .. row.Scope .. " | " .. row.Target .. " | " .. row.Error
    end
    return table.concat(lines, "\n")
end

local function buildFullDump()
    local parts = {"return {"}
    for _, entry in ipairs(fullDumpEntries) do
        parts[#parts + 1] = "{Path=" .. luaQuote(entry.Path) .. ",Root=" .. luaQuote(entry.Root) .. ",Class=" .. luaQuote(entry.Class) .. ",Source=" .. longQuote(entry.Source) .. "},"
    end
    parts[#parts + 1] = "}"
    return table.concat(parts, "\n")
end

local function buildCapabilities()
    local result = {mode = state.Mode, executor = getExecutorName()}
    for _, name in ipairs(capNames) do
        result[name] = caps[name] == true
    end
    result.debugInfo = caps.debugInfo == true
    return result
end

local function selectedRootManifest()
    local result = {}
    for _, entry in ipairs(roots) do
        if entry.Selected then
            local scan = scanCache[entry.Id]
            result[#result + 1] = {
                id = entry.Id,
                group = entry.Group,
                scripts = scan and scan.Scripts or nil,
                remotes = scan and scan.Remotes or nil
            }
        end
    end
    return result
end

local function writeOutputs()
    local files = {
        {"_INDEX.luau", "return " .. serialize(codeIndex)},
        {"_FILTER_REPORT.txt", buildFilterReport()},
        {"_ERROR_LOG.txt", buildErrorLog()}
    }
    if options.Remotes then
        files[#files + 1] = {"_REMOTE_MAP.luau", "return " .. serialize(remoteIndex)}
    end
    if options.RuntimeLinked then
        files[#files + 1] = {"_RUNTIME_INDEX.luau", "return " .. serialize(runtimeIndex)}
    end
    if options.FullDump then
        files[#files + 1] = {sanitize(state.Game) .. "_" .. tostring(state.PlaceId) .. "_FULL_DUMP.luau", buildFullDump()}
    end

    local manifest = {
        name = "any dumper",
        credit = "any ne",
        game = state.Game,
        placeId = state.PlaceId,
        placeVersion = nil,
        jobId = game.JobId,
        executor = getExecutorName(),
        mode = state.Mode,
        runRoot = state.RunRoot,
        generatedAt = os.time(),
        durationSeconds = math.max(0, state.FinishedAt - state.StartedAt),
        selectedRoots = selectedRootManifest(),
        options = jsonSafe(options),
        counts = {code = state.Code, remotes = state.Remotes, runtime = state.Runtime, failed = state.Failed},
        filter = jsonSafe(filterStats)
    }
    pcall(function()
        manifest.placeVersion = game.PlaceVersion
    end)
    local okManifest, manifestJson = pcall(function()
        return HttpService:JSONEncode(manifest)
    end)
    if okManifest then
        files[#files + 1] = {"_MANIFEST.json", manifestJson}
    else
        recordError("JSON", "manifest", manifestJson)
    end
    local okCaps, capsJson = pcall(function()
        return HttpService:JSONEncode(buildCapabilities())
    end)
    if okCaps then
        files[#files + 1] = {"_CAPABILITIES.json", capsJson}
    end

    for _, file in ipairs(files) do
        local ok, err = writeVerified(state.RunRoot .. "/" .. file[1], file[2])
        if not ok then
            recordError("WRITE_CORE", file[1], err)
        end
    end

    local status = table.concat({
        "any dumper",
        "credit: any ne",
        "phase: " .. state.Phase,
        "mode: " .. state.Mode,
        "game: " .. state.Game,
        "placeId: " .. tostring(state.PlaceId),
        "runRoot: " .. state.RunRoot,
        "code: " .. tostring(state.Code),
        "remotes: " .. tostring(state.Remotes),
        "runtime: " .. tostring(state.Runtime),
        "failed: " .. tostring(state.Failed),
        "duration: " .. string.format("%.2fs", math.max(0, state.FinishedAt - state.StartedAt))
    }, "\n")
    writeVerified(state.RunRoot .. "/_DUMP_STATUS.txt", status)
end

local function storeMemoryFallback()
    genv.AnyDumper_Output = {
        RunRoot = state.RunRoot,
        Index = codeIndex,
        Remotes = remoteIndex,
        Runtime = runtimeIndex,
        Filter = jsonSafe(filterStats),
        Errors = errors
    }
end

local function runDump()
    if state.Running or state.Scanning or not state.ScanReady then
        return false
    end
    local chosen = selectedRoots()
    if #chosen == 0 then
        state.Phase = "SELECT ROOTS"
        updateUI()
        return false
    end

    state.Running = true
    state.Cancelled = false
    state.Phase = "PREPARING"
    state.StartedAt = os.clock()
    state.FinishedAt = 0
    clearRunData()
    state.Game = getGameName()
    state.PlaceId = game.PlaceId
    state.RunRoot = makeRunRoot()
    updateUI()

    local fileReady = caps.writefile and caps.makefolder
    if fileReady then
        local okFolder, folderErr = ensureFolder(state.RunRoot)
        if not okFolder then
            fileReady = false
            recordError("FILESYSTEM", state.RunRoot, folderErr)
        end
    end

    state.Phase = "DISCOVERING"
    updateUI()
    local scripts = discoverSelectedScripts()

    state.Phase = "DUMPING CODE"
    updateUI()
    for index, item in ipairs(scripts) do
        if state.Cancelled then
            break
        end
        if fileReady then
            dumpScript(item)
        else
            local source, method, decompileError = readScriptSource(item.Instance)
            local fullName = safeFullName(item.Instance)
            local row = {
                Name = safeString(item.Instance.Name),
                Class = safeClass(item.Instance),
                FullName = fullName,
                SelectedRoot = item.Entry.Id,
                Origin = item.Entry.Group,
                ReasonAccepted = item.Reason,
                Method = method or "none",
                Status = source and "MEMORY" or "FAILED"
            }
            codeIndex[#codeIndex + 1] = row
            if source then
                state.Code = state.Code + 1
                if options.FullDump then
                    fullDumpEntries[#fullDumpEntries + 1] = {Path = fullName, Root = item.Entry.Id, Class = safeClass(item.Instance), Source = source}
                end
            else
                recordError("DECOMPILE", fullName, decompileError or "no readable source")
            end
        end
        if index % 18 == 0 then
            updateUI()
            task.wait()
        end
    end

    if not state.Cancelled then
        state.Phase = "REMOTES"
        updateUI()
        collectSelectedRemotes()
    end

    if not state.Cancelled then
        state.Phase = "RUNTIME"
        updateUI()
        collectRuntime()
    end

    state.FinishedAt = os.clock()
    if state.Cancelled then
        state.Phase = "CANCELLED"
    elseif state.Failed > 0 then
        state.Phase = "COMPLETE*"
    else
        state.Phase = "COMPLETE"
    end

    if fileReady then
        state.Phase = state.Cancelled and "CANCELLED" or "WRITING"
        updateUI()
        writeOutputs()
        state.Phase = state.Cancelled and "CANCELLED" or (state.Failed > 0 and "COMPLETE*" or "COMPLETE")
    else
        storeMemoryFallback()
    end

    state.Running = false
    updateUI()
    return true
end

