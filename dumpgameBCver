local function analyzeBackdoorThreat(inst, content, method)
    if method == "FAILED" then
        return {
            Score = 0,
            Level = "ANALYSIS_FAILED",
            Confidence = "NONE",
            AnalysisComplete = false,
            Reasons = {
                {
                    Score = 0,
                    Desc = "Source extraction failed (bytecode stripped or protected)",
                    Line = nil
                }
            }
        }
    end

    local score = 0
    local reasons = {}
    local lowerName = inst.Name:lower():gsub("%s+", "")

    if EXACT_SUSPICIOUS_NAMES[lowerName] then
        score = score + EXACT_SUSPICIOUS_NAMES[lowerName]
        table.insert(reasons, {
            Score = EXACT_SUSPICIOUS_NAMES[lowerName],
            Desc = string.format("Object name signature matched: %s", inst.Name),
            Line = nil
        })
    else
        for prefix, weight in pairs(EXACT_PREFIX_NAMES) do
            if lowerName:sub(1, #prefix) == prefix then
                score = score + weight
                table.insert(reasons, {
                    Score = weight,
                    Desc = string.format("Object prefix signature matched: %s", prefix),
                    Line = nil
                })
                break
            end
        end
    end

    if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent") then
        local parentName = inst.Parent and inst.Parent.ClassName or "None"
        if parentName == "JointsService" or parentName == "TestService" or parentName == "NullService" then
            score = score + 45
            table.insert(reasons, {
                Score = 45,
                Desc = string.format("Remote concealed inside non-standard container: %s", parentName),
                Line = nil
            })
        end
        if lowerName == "execute" or lowerName == "run" or lowerName == "eval" or lowerName == "payload" then
            score = score + 40
            table.insert(reasons, {
                Score = 40,
                Desc = string.format("Remote identifier indicates command dispatch: %s", inst.Name),
                Line = nil
            })
        end
    end

    if type(content) == "string" and #content > 0 then
        local lineArray = {}
        for line in content:gmatch("([^\r\n]*)[\r\n]?") do
            table.insert(lineArray, line)
        end

        for _, rule in ipairs(DANGEROUS_CALL_PATTERNS) do
            local matchedLine = nil
            for lineIdx, lineText in ipairs(lineArray) do
                if lineText:find(rule.pattern) then
                    matchedLine = lineIdx
                    break
                end
            end
            if matchedLine then
                score = score + rule.weight
                table.insert(reasons, {
                    Score = rule.weight,
                    Desc = rule.desc,
                    Line = matchedLine
                })
            end
        end

        for lineIdx, lineText in ipairs(lineArray) do
            for assetIdStr in lineText:gmatch("require%s*%(%s*(%d+)%s*%)") do
                local assetId = tonumber(assetIdStr)
                if assetId and not KNOWN_LEGIT_MODULE_ASSETS[assetId] then
                    score = score + 20
                    table.insert(reasons, {
                        Score = 20,
                        Desc = string.format("External AssetId require loader: require(%d)", assetId),
                        Line = lineIdx
                    })
                end
            end
        end

        if content:find("MoonSecV") or content:find("Luraph") or content:find("IronBrew") then
            local hasNetwork = content:find("HttpService") or content:find("MarketplaceService") or content:find("Players")
            if hasNetwork then
                score = score + 65
                table.insert(reasons, {
                    Score = 65,
                    Desc = "Obfuscated wrapper combined with engine runtime access",
                    Line = nil
                })
            end
        end
    end

    local level = "CLEAN"
    if score >= 80 then
        level = "HIGH"
    elseif score >= 40 then
        level = "MEDIUM"
    elseif score > 0 then
        level = "LOW"
    end

    return {
        Score = score,
        Level = level,
        Confidence = "HEURISTIC",
        AnalysisComplete = true,
        Reasons = reasons
    }
end

local function buildReasonFingerprint(threat)
    if not threat or not threat.Reasons or #threat.Reasons == 0 then
        return ""
    end
    local parts = {}
    for _, reason in ipairs(threat.Reasons) do
        table.insert(parts, string.format("%s:%s:%s", tostring(reason.Score), tostring(reason.Desc), tostring(reason.Line or 0)))
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

