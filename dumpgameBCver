local function rootForInstance(instance)
    local preferred = {"Character", "PlayerScripts", "PlayerGui", "Backpack"}
    for _, idValue in ipairs(preferred) do
        for _, entry in ipairs(roots) do
            if entry.Id == idValue and entry.Selected then
                local root = entry.Root()
                if root and (instance == root or isDescendant(instance, root)) then
                    return entry, root
                end
            end
        end
    end
    for _, entry in ipairs(roots) do
        if entry.Selected then
            local root = entry.Root()
            if root and (instance == root or isDescendant(instance, root)) then
                return entry, root
            end
        end
    end
end

local function instanceAllowed(instance, entry, root)
    if not instance or not root then
        return false, "MissingRoot"
    end
    if safeClass(instance) == "CoreScript" then
        return false, "CoreScript"
    end
    if isDescendant(instance, CoreGui) then
        return false, "CoreGui"
    end
    local characterOwner = belongsToAnyCharacter(instance)
    if characterOwner then
        if entry.Id == "Character" and characterOwner == LocalPlayer then
            return true, "LocalCharacter"
        end
        return false, characterOwner == LocalPlayer and "CharacterNotSelected" or "OtherPlayerCharacter"
    end
    if entry.Group == "Local Player" then
        if isDefaultLocalObject(instance) then
            return false, "RobloxDefaultPlayer"
        end
        return true, "LocalPlayerRoot"
    end
    return true, "SelectedGameRoot"
end

local function relativeSegments(instance, root, entry)
    local segments = {sanitize(entry.Id)}
    if instance == root then
        return segments
    end
    local chain = {}
    local cursor = instance
    local guard = 0
    while cursor and cursor ~= root and guard < 100 do
        table.insert(chain, 1, sanitize(cursor.Name))
        cursor = safeParent(cursor)
        guard = guard + 1
    end
    for _, segment in ipairs(chain) do
        segments[#segments + 1] = segment
    end
    return segments
end

local function outputPath(kind, entry, root, instance, extension)
    local parts = {state.RunRoot, kind}
    for _, segment in ipairs(relativeSegments(instance, root, entry)) do
        parts[#parts + 1] = segment
    end
    local path = table.concat(parts, "/") .. extension
    return uniquePath(path)
end

