local function runStamp()
    local ok, value = pcall(function()
        return os.date("!%Y%m%d_%H%M%S")
    end)
    if ok and type(value) == "string" then
        return value
    end
    return tostring(os.time())
end

local function makeRunRoot()
    state.BaseRoot = sanitize(state.Game) .. "_" .. tostring(state.PlaceId) .. "_Dump"
    local base = state.BaseRoot .. "/Run_" .. runStamp()
    local root = base
    local index = 2
    if caps.isfolder then
        while true do
            local ok, exists = pcall(isfolderFn, root)
            if not ok or not exists then
                break
            end
            root = base .. "_" .. tostring(index)
            index = index + 1
        end
    else
        root = base .. "_" .. shortHash(tostring(os.clock())):sub(1, 4)
    end
    return root
end

