    for _, descriptor in ipairs(rootDescriptors) do
        structure[descriptor.Key] = {
            selected = descriptor.Selected,
            group = descriptor.Group,
            code = descriptor.ScriptCount,
            remotes = descriptor.RemoteCount
        }
    end
    writeJson(state.RunRoot .. "/_STRUCTURE.json", structure)
    timings.Write = os.clock() - started
    writeJson(state.RunRoot .. "/_MANIFEST.json", {
        name = "any dumper",
        credit = "any ne",
        game = state.GameName,
        placeId = state.PlaceId,
        jobId = game.JobId,
        mode = state.Mode,
        executor = executorName(),
        generatedAt = os.time(),
        runRoot = state.RunRoot,
        counts = {
            code = state.Scripts,
            remotes = state.Remotes,
            runtime = state.Runtime,
            actors = #actorRows,
            networkEvents = #networkRows,
            failed = state.Failed
        },
        capabilities = capProfile.Summary,
        network = networkSummary,
        durationSeconds = math.max(0, os.clock() - state.StartedAt),
        timings = timings
    })
    timings.Write = os.clock() - started
end

local function finalizeRun(cancelled)
    if Network.Active then Network.stop() end
    state.FinishedAt = os.clock()
    if cancelled then
        state.Phase = "CANCELLED"
        state.Message = "Cancelled · partial run kept"
    elseif state.Failed > 0 then
        state.Phase = "COMPLETE*"
        state.Message = tostring(state.Scripts) .. " code · " .. tostring(state.Remotes) .. " remotes · " .. tostring(state.Runtime) .. " runtime · " .. tostring(state.Failed) .. " failed"
    else
        state.Phase = "COMPLETE"
        state.Message = tostring(state.Scripts) .. " code · " .. tostring(state.Remotes) .. " remotes · " .. tostring(state.Runtime) .. " runtime"
    end
    state.Running = false
    if state.RunRoot ~= "" and writefileFn then
        pcall(function()
            writeVerified(state.RunRoot .. "/_ERROR_LOG.txt", buildErrorLog(), false)
            writeVerified(state.RunRoot .. "/_FILTER_REPORT.txt", buildFilterReport(), false)
            writeVerified(state.RunRoot .. "/_DUMP_STATUS.txt", buildStatus(), false)
        end)
    end
    updateUI()
end

local function makeRunRoot()
    local base = state.Root .. "/Run_" .. timestamp()
    if not isfolderFn then
        return base
    end
    local candidate = base
    local suffix = 1
    while true do
        local ok, exists = pcall(isfolderFn, candidate)
        if not ok or not exists then
            return candidate
        end
        suffix = suffix + 1
        candidate = base .. "_" .. tostring(suffix)
    end
end

local function startDump()
    if state.Running or state.Scanning or not state.Scanned then
        return
    end
    if not writefileFn or not makefolderFn then
        state.Message = "Executor needs writefile + makefolder"
        state.Phase = "FAILED"
        updateUI()
        return
    end
    state.Message = "Checking executor strategy..."
    updateUI()
    Capability.ensure()
    resetDumpState()
    state.Running = true
    state.Cancelled = false
    state.StartedAt = os.clock()
    state.FinishedAt = 0
    state.Phase = "STARTING"
    state.GameName = getGameName()
    state.Root = sanitize(state.GameName) .. "_" .. tostring(state.PlaceId) .. "_Dump"
    state.RunRoot = makeRunRoot()
    local okFolder, folderErr = ensureFolder(state.RunRoot)
    if not okFolder then
        recordError("FILESYSTEM", state.RunRoot, folderErr)
        finalizeRun(false)
        return
    end
    savePreferences()
    updateUI()

    local networkStarted = Network.start()
    dumpScripts()
    if not state.Cancelled then dumpRemotes() end
    if not state.Cancelled then collectRuntime() end
    if not state.Cancelled then Actor.collect() end
    if networkStarted then Network.stop() end
    writeOutputs()
    state.FinishedAt = os.clock()
    finalizeRun(state.Cancelled)
end

resolveRoots()
state.GameName = getGameName()
buildUI()
updateUI()
task.spawn(function()
    state.Message = "Checking executor capabilities..."
    updateUI()
    Capability.run()
    if not state.Running and not state.Scanning then state.Message = "Choose roots, then scan structure"; state.Phase = "READY" end
    updateUI()
end)

ui.scanButton.MouseButton1Click:Connect(function()
    task.spawn(scanStructure)
end)

ui.dumpButton.MouseButton1Click:Connect(function()
    task.spawn(startDump)
end)

env.AnyDumper = {
    Scan = function()
        if state.Running or state.Scanning then
            return false, "busy"
        end
        task.spawn(scanStructure)
        return true
    end,
    Run = function()
        if state.Running or state.Scanning then
            return false, "busy"
        end
        if not state.Scanned then
            return false, "scan first"
        end
        task.spawn(startDump)
        return true
    end,
    Cancel = function()
        if state.Running or state.Scanning then
            state.Cancelled = true
            return true
        end
        return false
    end,
    SetMode = function(mode)
        if state.Running or state.Scanning then
            return false, "busy"
        end
        local normalized = string.lower(safeString(mode))
        if normalized == "strict" then
            state.Mode = "Strict"
        elseif normalized == "deep" then
            state.Mode = "Deep"
        else
            state.Mode = "Balanced"
        end
        savePreferences()
        updateUI()
        return true, state.Mode
    end,
    GetStatus = function()
        return {
            Running = state.Running,
            Scanning = state.Scanning,
            Scanned = state.Scanned,
            Phase = state.Phase,
            Mode = state.Mode,
            RunRoot = state.RunRoot,
            Message = state.Message,
            Code = state.Scripts,
            Remotes = state.Remotes,
            Runtime = state.Runtime,
            Failed = state.Failed,
            Processed = state.Processed,
            Total = state.Total
        }
    end,
    GetCapabilities = function() return jsonSafe(capProfile) end,
    RefreshCapabilities = function()
        if state.Running or state.Scanning or capabilityBusy then return false, "busy" end
        task.spawn(function() state.Message = "Refreshing capabilities..."; updateUI(); Capability.run(); state.Message = "Capabilities refreshed"; updateUI() end)
        return true
    end,
    GetNetworkTrace = function() return {Summary = jsonSafe(networkSummary), Events = jsonSafe(networkRows)} end,
    GetActors = function() return jsonSafe(actorRows) end,
    GetScan = function()
        local result = {}
        for _, descriptor in ipairs(rootDescriptors) do
            result[descriptor.Key] = {
                Selected = descriptor.Selected,
                Group = descriptor.Group,
                Code = descriptor.ScriptCount,
                Remotes = descriptor.RemoteCount
            }
        end
        return result
    end,
    Destroy = function()
        state.Cancelled = true
        pcall(function()
            if ui.gui then
                ui.gui:Destroy()
            end
        end)
        env.AnyDumper = nil
    end
}
