local function safeMakeDir(path)
    if not makeFolder then
        return false
    end
    local current = ""
    for segment in path:gmatch("[^/\\]+") do
        current = current == "" and segment or current .. "/" .. segment
        local exists = false
        if isFolder then
            pcall(function() exists = isFolder(current) end)
        end
        if not exists then
            local ok = pcall(function() makeFolder(current) end)
            if not ok and isFolder then
                pcall(function() exists = isFolder(current) end)
                if not exists then return false end
            end
        end
    end
    return true
end

