task.spawn(function()
	local tbl = { "ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles", "Explosion", "Sound" }

	local tbl2 = {
		Thrown = true,
		Preload = true,
		Built = true,
		Benchs = true,
		["Floor/Roads"] = true,
		GrassBottom = true,
		GrassTop = true,
		Stuff = true,
		Trash = true,
		Trees = true,
		Grass = true,
		Walls = true,
		Tunnel = true,
	}

	local function fn(arg)
		for _, v in tbl, nil, nil do
			if arg:IsA(v) then
				return true
			end
		end

		if (arg:IsA("Folder") or arg:IsA("Model")) and tbl2[arg.Name] then
			return true
		end
		return false
	end

	local queue = {}
	local queued = setmetatable({}, { __mode = "k" })
	local head = 1
	local tail = 0

	local function fn2(descendant)
		if descendant and descendant.Parent and fn(descendant) and not queued[descendant] then
			queued[descendant] = true
			tail += 1
			queue[tail] = descendant
		end
	end

	workspace.DescendantAdded:Connect(fn2)

	for _, v in workspace:GetDescendants() do
		fn2(v)
	end

	task.spawn(function()
		while true do
			local processed = 0

			while head <= tail and processed < 128 do
				local descendant = queue[head]
				queue[head] = nil
				head += 1
				processed += 1

				if descendant then
					queued[descendant] = nil
					if descendant.Parent then
						pcall(function()
							descendant:Destroy()
						end)
					end
				end
			end

			if head > tail then
				table.clear(queue)
				head = 1
				tail = 0
			end

			RunService.Heartbeat:Wait()
		end
	end)
end)

